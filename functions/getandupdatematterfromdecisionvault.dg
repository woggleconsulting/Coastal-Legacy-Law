string standalone.getAndUpdateMatterFromDecisionVault(String crmAPIRequest)
{
// Created By: Harjot Singh - Aether Automation
// Created On: May 9 2025
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// get the arguments passed from Decsion Vault via webhook
inputMap = crmAPIRequest.toMap();
bodyJson = inputMap.get("body");
bodyMap = bodyJson.toMap();
info bodyMap;
eventType = bodyMap.get("event_type");
decisionVaultMatterID = bodyMap.get("matter").get("id");
queryMap = Map();
queryMap.put("select_query","select id from Decision_Vault_Forms where Form_ID = '" + decisionVaultMatterID + "' limit 1");
response = invokeurl
[
	url :"https://www.zohoapis.com/crm/v8/coql"
	type :POST
	parameters:queryMap.toString()
	connection:"zcrm"
];
matterZoho = response.get("data").get(0).get("id");
statusValue = "";
if(eventType == "intakeform.started")
{
	statusValue = "Started";
}
else if(eventType == "intakeform.completed")
{
	statusValue = "Completed";
}
else if(eventType == "intakeform.submitted")
{
	statusValue = "Submitted";
}
else if(eventType == "intakeform.resubmitted")
{
	statusValue = "Resubmitted";
}
else
{
	statusValue = "Unknown";
}
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Update the CRM record with modified subform
updateMap = Map();
updateMap.put("Form_Status",statusValue);
updateResp = zoho.crm.updateRecord("Decision_Vault_Forms",matterZoho,updateMap);
info updateResp;
sendmail
[
	from :zoho.loginuserid
	to :"harjot@aetherautomation.com"
	subject :"Decision Vault Webhook Processed"
	message :"Updated Current_Form_Status to " + statusValue + " for Deal ID: " + matterZoho
]
return "Webhook received and processed.";
}
