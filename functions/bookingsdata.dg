string standalone.getBookingsData()
{
// ══════════════════════════════════════════════════════
// Zoho Bookings Configuration Export
// Exports: workspaces, services, service details,
//          staff, staff details, and recent appointments
// Connection: "zbookings" (Zoho Bookings OAuth)
// Upload:   WorkDrive team folder
//
// API docs: https://www.zoho.com/bookings/help/api/v1/
// ══════════════════════════════════════════════════════
returnMap = Map();
errorLog = list();
// ── 1. Workspaces ──
// GET /bookings/v1/json/workspaces
workspacesResp = invokeurl
[
	url :"https://www.zohoapis.com/bookings/v1/json/workspaces"
	type :GET
	connection:"zbookings"
];
if(workspacesResp.containKey("response") && workspacesResp.get("response").containKey("returnvalue"))
{
	workspaces = workspacesResp.get("response").get("returnvalue").get("data");
	returnMap.put("workspaces",workspaces);
	info "Workspaces retrieved: " + workspaces.size();
}
else
{
	errMsg = "Workspaces: " + workspacesResp.toString().subString(0,300);
	errorLog.add(errMsg);
	info "FAILED at " + errMsg;
}
// ── 2. Services (per workspace) ──
// GET /bookings/v1/json/services?workspace_id={id}
// Required param: workspace_id
allServices = list();
if(returnMap.containKey("workspaces"))
{
	for each  ws in returnMap.get("workspaces")
	{
		wsId = ws.get("id").toString();
		wsName = ws.get("name").toString();
		servicesResp = invokeurl
		[
			url :"https://www.zohoapis.com/bookings/v1/json/services?workspace_id=" + wsId
			type :GET
			connection:"zbookings"
		];
		if(servicesResp.containKey("response") && servicesResp.get("response").containKey("returnvalue"))
		{
			servicesList = servicesResp.get("response").get("returnvalue").get("data");
			for each  svc in servicesList
			{
				svc.put("_workspace_id",wsId);
				svc.put("_workspace_name",wsName);
				allServices.add(svc);
			}
			info "Services for workspace '" + wsName + "': " + servicesList.size();
		}
		else
		{
			errMsg = "Services (workspace " + wsName + "): " + servicesResp.toString().subString(0,300);
			errorLog.add(errMsg);
			info "FAILED at " + errMsg;
		}
	}
}
returnMap.put("services",allServices);
info "Total services: " + allServices.size();
// ── 3. Service detail (per service) ──
// GET /bookings/v1/json/services?workspace_id={wsId}&service_id={svcId}
// Uses same endpoint as section 2 with optional service_id param
serviceDetails = list();
for each  svc in allServices
{
	svcId = svc.get("id").toString();
	svcName = svc.get("name").toString();
	svcWsId = svc.get("_workspace_id").toString();
	svcDetailResp = invokeurl
	[
		url :"https://www.zohoapis.com/bookings/v1/json/services?workspace_id=" + svcWsId + "&service_id=" + svcId
		type :GET
		connection:"zbookings"
	];
	if(svcDetailResp.containKey("response") && svcDetailResp.get("response").containKey("returnvalue"))
	{
		detailRaw = svcDetailResp.get("response").get("returnvalue");
		if(detailRaw.containKey("data"))
		{
			detail = detailRaw.get("data").get(0);
		}
		else
		{
			detail = detailRaw;
		}
		detail.put("_workspace_id",svcWsId);
		detail.put("_workspace_name",svc.get("_workspace_name"));
		serviceDetails.add(detail);
		info "Service detail " + serviceDetails.size() + "/" + allServices.size() + ": " + svcName;
	}
	else
	{
		errMsg = "Service detail '" + svcName + "' (ID: " + svcId + "): " + svcDetailResp.toString().subString(0,300);
		errorLog.add(errMsg);
		info "FAILED at " + errMsg;
	}
}
returnMap.put("serviceDetails",serviceDetails);
// ── 4. Staff ──
// GET /bookings/v1/json/staffs
// Optional params: staff_id, service_id, staff_email, workspace_id
staffResp = invokeurl
[
	url :"https://www.zohoapis.com/bookings/v1/json/staffs"
	type :GET
	connection:"zbookings"
];
if(staffResp.containKey("response") && staffResp.get("response").containKey("returnvalue"))
{
	staffRaw = staffResp.get("response").get("returnvalue");
	if(staffRaw.containKey("data"))
	{
		staff = staffRaw.get("data");
	}
	else
	{
		staff = staffRaw;
	}
	returnMap.put("staff",staff);
	info "Staff retrieved: " + staff.size();
}
else
{
	errMsg = "Staff: " + staffResp.toString().subString(0,300);
	errorLog.add(errMsg);
	info "FAILED at " + errMsg;
}
// ── 5. Staff detail (per staff member) ──
// GET /bookings/v1/json/staffs?staff_id={id}
// Uses same endpoint as section 4 with optional staff_id param
staffDetails = list();
if(returnMap.containKey("staff"))
{
	for each  member in returnMap.get("staff")
	{
		memberId = member.get("id").toString();
		memberName = member.get("name").toString();
		staffDetailResp = invokeurl
		[
			url :"https://www.zohoapis.com/bookings/v1/json/staffs?staff_id=" + memberId
			type :GET
			connection:"zbookings"
		];
		if(staffDetailResp.containKey("response") && staffDetailResp.get("response").containKey("returnvalue"))
		{
			memberDetailRaw = staffDetailResp.get("response").get("returnvalue");
			if(memberDetailRaw.containKey("data"))
			{
				memberDetail = memberDetailRaw.get("data").get(0);
			}
			else
			{
				memberDetail = memberDetailRaw;
			}
			staffDetails.add(memberDetail);
			info "Staff detail " + staffDetails.size() + ": " + memberName;
		}
		else
		{
			errMsg = "Staff detail '" + memberName + "' (ID: " + memberId + "): " + staffDetailResp.toString();
			errorLog.add(errMsg);
			info "FAILED at " + errMsg;
		}
	}
}
returnMap.put("staffDetails",staffDetails);
// ── 6. Fetch Appointments (last 90 days + next 30) ──
// POST /bookings/v1/json/fetchappointment
// Params passed as form-data in request body
// Date format: dd-MMM-yyyy HH:mm:ss (e.g. 30-Apr-2019 22:00:00)
// All params optional; no params = today's appointments
// Response shape: response.returnvalue.response[] (not .data[])
// 50 per page default, max 100, next_page_available flag
today = zoho.currentdate;
fromDate = today.subDay(90).toString("dd-MMM-yyyy") + " 00:00:00";
toDate = today.addDay(30).toString("dd-MMM-yyyy") + " 23:59:59";
apptParams = Map();
apptParams.put("from_time",fromDate);
apptParams.put("to_time",toDate);
apptParams.put("per_page","100");
allAppointments = list();
currentPage = 1;
hasMore = true;
if(hasMore)
{
	apptParams.put("page",currentPage.toString());
	appointmentsResp = invokeurl
	[
		url :"https://www.zohoapis.com/bookings/v1/json/fetchappointment"
		type :POST
		parameters:apptParams
		connection:"zbookings"
	];
	if(appointmentsResp.containKey("response") && appointmentsResp.get("response").containKey("returnvalue"))
	{
		apptReturnVal = appointmentsResp.get("response").get("returnvalue");
		if(apptReturnVal.containKey("response"))
		{
			pageAppointments = apptReturnVal.get("response");
			allAppointments.addAll(pageAppointments);
			info "Appointments page " + currentPage + ": " + pageAppointments.size() + " records";
			// Check for next page
			if(apptReturnVal.containKey("next_page_available") && apptReturnVal.get("next_page_available").toString().equals("true"))
			{
				currentPage = currentPage + 1;
			}
			else
			{
				hasMore = false;
			}
		}
		else
		{
			hasMore = false;
			info "Appointments: no 'response' key in returnvalue";
		}
	}
	else if(appointmentsResp.toString().contains("No appointment") || appointmentsResp.toString().contains("no data"))
	{
		hasMore = false;
		info "No appointments in date range";
	}
	else
	{
		errMsg = "Appointments (page " + currentPage + "): " + appointmentsResp.toString().subString(0,300);
		errorLog.add(errMsg);
		info "FAILED at " + errMsg;
		hasMore = false;
	}
}
returnMap.put("appointments_sample",allAppointments);
info "Total appointments: " + allAppointments.size();
// ── 7. Error summary ──
returnMap.put("_errors",errorLog);
returnMap.put("_exportDate",zoho.currentdate.toString("yyyy-MM-dd HH:mm:ss"));
returnMap.put("_exportFunction","getBookingsData");
if(errorLog.size() > 0)
{
	info "Completed with " + errorLog.size() + " errors: " + errorLog.toString();
}
else
{
	info "All bookings data retrieved successfully";
}
// ── 8. Upload to WorkDrive ──
teamFolderId = "v62d8f132e2f0c3414cfab829218e5ce62f74";
fileName = "bookingsData_" + zoho.currentdate.toString("yyyyMMdd_HHmmss") + ".json";
jsonString = returnMap.toString();
uploadResp = zoho.workdrive.uploadFile(jsonString.toFile(fileName),teamFolderId,fileName,false,"zworkdrive");
if(uploadResp == null)
{
	info "FAILED at WorkDrive upload: null response";
	return "ERROR: WorkDrive upload failed - null response";
}
info "File uploaded: " + uploadResp;
return returnMap.toString();
}
