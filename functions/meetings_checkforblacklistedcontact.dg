void automation.meetings_checkForBlacklistedContact(Int recId)
{
templateId = "6994809000004355330";
eventRecord = zoho.crm.getRecordById("Events",recId);
ownerInfo = eventRecord.get("Owner");
ownerEmail = ownerInfo.get("email");
contactLookup = eventRecord.get("Who_Id");
contactId = contactLookup.get("id");
contactRecord = zoho.crm.getRecordById("Contacts",contactId);
tagList = contactRecord.get("Tag");
blacklisted = false;
if(tagList != null)
{
	for each  tag in tagList
	{
		if(tag.get("name") == "Blacklisted")
		{
			blacklisted = true;
			break;
		}
	}
}
info tagList;
info blacklisted;
if(blacklisted == true)
{
	sendMailReqMap = Map();
	fromMap = Map();
	fromMap.put("email",zoho.adminuserid);
	sendMailReqMap.put("from",fromMap);
	/* TO LIST */
	toList = List();
	toMap = Map();
	toMap.put("email",ownerEmail);
	toList.add(toMap);
	sendMailReqMap.put("to",toList);
	/* TEMPLATE */
	templateMap = Map();
	templateMap.put("id",templateId);
	sendMailReqMap.put("template",templateMap);
	/* MODULE */
	moduleMap = Map();
	moduleMap.put("api_name","Events");
	sendMailReqMap.put("module",moduleMap);
	/* REQUEST */
	dataList = List();
	dataList.add(sendMailReqMap);
	sendMailReq = Map();
	sendMailReq.put("data",dataList);
	info sendMailReq;
	info sendMailReq.toString();
	sendMail = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v8/Events/" + recId + "/actions/send_mail"
		type :POST
		body:sendMailReq.toString()
		headers:{"Content-Type":"application/json"}
		connection:"zcrm"
	];
	info sendMail;
}
}
