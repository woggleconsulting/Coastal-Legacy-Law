void automation.contacts_updateDeceasedFields(Int contactId)
{
info "=== START: Processing deceased status for Contact ID: " + contactId + " ===";
contactRec = zoho.crm.getRecordById("Contacts",contactId);
contactDeceased = false;
tagMattersAsDeceased = false;
// Check if current contact has "Deceased" tag
for each  tag in contactRec.get("Tag")
{
	if(tag.get("name").equals("Deceased"))
	{
		contactDeceased = true;
		info "Contact is marked as deceased";
		break;
	}
}
// If contact is deceased, check spouse situation
if(contactDeceased)
{
	spouseLookup = contactRec.get("Spouse_Partner");
	if(spouseLookup != null)
	{
		info "Contact has a spouse - checking spouse status";
		spouseId = spouseLookup.get("id");
		// Update spouse's Spouse_Deceased field
		updateSpouse = zoho.crm.updateRecord("Contacts",spouseId,{"Spouse_Deceased":true});
		info "Updated spouse's Spouse_Deceased field to true";
		// Check if spouse is also deceased
		spouseRec = zoho.crm.getRecordById("Contacts",spouseId);
		spouseDeceased = false;
		for each  spouseTag in spouseRec.get("Tag")
		{
			if(spouseTag.get("name").equals("Deceased"))
			{
				spouseDeceased = true;
				info "Spouse is also marked as deceased";
				break;
			}
		}
		// Only tag matters if BOTH are deceased
		if(spouseDeceased)
		{
			tagMattersAsDeceased = true;
			info "DECISION: Both contact and spouse deceased - will tag matters";
		}
		else
		{
			info "DECISION: Spouse is still alive - will NOT tag matters";
		}
	}
	else
	{
		// Contact is deceased with no spouse
		tagMattersAsDeceased = true;
		info "DECISION: Contact deceased with no spouse - will tag matters";
	}
}
else
{
	info "Contact is NOT marked as deceased";
	// If contact not deceased, clear spouse's Spouse_Deceased field if they have one
	spouseLookup = contactRec.get("Spouse_Partner");
	if(spouseLookup != null)
	{
		spouseId = spouseLookup.get("id");
		updateSpouse = zoho.crm.updateRecord("Contacts",spouseId,{"Spouse_Deceased":false});
		info "Cleared spouse's Spouse_Deceased field";
	}
}
// Find all related matters
criteria = "((Contact_Name:equals:" + contactId + ") or (Spouse_Name:equals:" + contactId + "))";
relatedMatters = zoho.crm.searchRecords("Deals",criteria);
if(relatedMatters != null && relatedMatters.size() > 0)
{
	info "Found " + relatedMatters.size() + " related matters";
	if(tagMattersAsDeceased)
	{
		info "Adding 'Deceased' tag to matters";
		// Add "Deceased" tag to all related matters
		for each  matter in relatedMatters
		{
			tag1 = Map();
			tag1.put("name","Deceased");
			tags_list = List();
			tags_list.add(tag1);
			param = Map();
			param.put("tags",tags_list);
			updateMatter_addTag = invokeurl
			[
				url :"https://www.zohoapis.com/crm/v8/Deals/" + matter.get("id") + "/actions/add_tags"
				type :POST
				parameters:param.toString()
				connection:"zcrm"
			];
			info "Added tag to Deal " + matter.get("id") + ": " + updateMatter_addTag;
		}
	}
	else
	{
		info "Removing 'Deceased' tag from matters";
		// Remove "Deceased" tag from all related matters
		for each  matter in relatedMatters
		{
			tag1 = Map();
			tag1.put("name","Deceased");
			tags_list = List();
			tags_list.add(tag1);
			param = Map();
			param.put("tags",tags_list);
			param.put("ids",{matter.get("id")});
			updateMatter_removeTag = invokeurl
			[
				url :"https://www.zohoapis.com/crm/v8/Deals/actions/remove_tags"
				type :POST
				parameters:param.toString()
				connection:"zcrm"
			];
			info "Removed tag from Deal " + matter.get("id") + ": " + updateMatter_removeTag;
		}
	}
}
else
{
	info "No related matters found";
}
info "=== END: Contact ID " + contactId + " ===";
}
