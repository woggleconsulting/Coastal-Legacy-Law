void automation.matters_updateRelatedContactsTag(int matterId)
{
//Get Matter record//
matterRecord = zoho.crm.getRecordById("Deals",matterId);
info {"matterRecord":matterRecord};
if(matterRecord.get("id") != null)
{
	contactIdsToTag = List();
	clientLookup = matterRecord.get("Contact_Name");
	if(clientLookup != null)
	{
		contactIdsToTag.add(clientLookup.get("id"));
		info "Added Client ID: " + clientLookup.get("id");
	}
	//Check for spouse and add to list if present//
	spouseLookup = matterRecord.get("Spouse_Name");
	if(spouseLookup != null)
	{
		contactIdsToTag.add(spouseLookup.get("id"));
		info "Added Spouse ID: " + spouseLookup;
	}
	//
	tagString = "No Longer Client";
	info "Final list of IDs to tag: " + contactIdsToTag;
	for each  contactId in contactIdsToTag
	{
		try 
		{
			info "Attempting to update Tag field for Contact ID: " + contactId;
			contactRec = zoho.crm.getRecordById("Contacts",contactId);
			currentTags = contactRec.get("Tag");
			updateTagList = List();
			if(currentTags != null && currentTags.size() > 0)
			{
				for each  existingTag in currentTags
				{
					existingTagMap = Map();
					existingTagMap.put("name",existingTag.get("name"));
					updateTagList.add(existingTagMap);
				}
			}
			newTagMap = Map();
			newTagMap.put("name",tagString);
			updateTagList.add(newTagMap);
			updateMap = Map();
			updateMap.put("Tag",updateTagList);
			response = zoho.crm.updateRecord("Contacts",contactId,updateMap);
			info "Tagged Contact [" + contactId + "] Result: " + response;
		}
		catch (e)
		{
			info "Error tagging " + contactId + ": " + e;
		}
	}
}
else
{
	info "Deal Record could not be retrieved or ID is null.";
}
}
