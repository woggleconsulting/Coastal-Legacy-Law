string standalone.generateFileName(string module, string recId)
{
recordResp = zoho.crm.getRecordById(module,recId);
recordType = if(module == "Leads",recordResp.get("Lead_Type"),recordResp.get("Contact_Type"));
firstName = recordResp.get("First_Name");
lastName = recordResp.get("Last_Name");
spouseLookup = recordResp.get("Spouse_Partner");
accountName = "";
if(recordType == "Client" || recordType == "Spouse of Client")
{
	if(spouseLookup != null)
	{
		spouseId = spouseLookup.get("id");
		spouseRec = zoho.crm.getRecordById(module,spouseId);
		spouseFirst = spouseRec.get("First_Name");
		spouseLast = spouseRec.get("Last_Name");
		if(spouseFirst != "" && spouseLast != "")
		{
			if(lastName == spouseLast)
			{
				accountName = lastName + ", " + firstName + " & " + spouseFirst;
			}
			else
			{
				accountName = lastName + ", " + firstName + " & " + spouseLast + ", " + spouseFirst;
			}
		}
		else
		{
			accountName = lastName + ", " + firstName;
		}
	}
	else
	{
		accountName = lastName + ", " + firstName;
	}
}
return accountName;
}
