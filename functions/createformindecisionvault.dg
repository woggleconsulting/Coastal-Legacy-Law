void automation.createFormInDecisionVault(Int RecordID)
{
CRMVariableOAuthToken = zoho.crm.getOrgVariable("CRMVariableOAuthToken");
RecordInfo = zoho.crm.getRecordById("Decision_Vault_Forms",RecordID);
info RecordInfo;
FormName = RecordInfo.get("Name");
DVFormSelected = RecordInfo.get("DecisonVault_Form");
MatterRecordID = RecordInfo.get("Matter").get("id");
GetQuestionnaires = standalone.getQuestionnaireIDs();
GetQuestionnaires = GetQuestionnaires.toList();
for each  Questionnaire in GetQuestionnaires
{
	if(Questionnaire.get("url_short_name") == DVFormSelected)
	{
		SelectedQuestionnaireID = Questionnaire.get("id");
		break;
	}
}
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// url, heaaders, and body for creating matter api call
createMatterURL = "https://api.decisionvault.com/v1/matters/create";
createMatterURLHeadersMap = Map();
createMatterURLHeadersMap.put("Authorization","Token " + CRMVariableOAuthToken);
createMatterURLHeadersMap.put("Content-Type","application/json");
createMatterURLBodyMap = Map();
createMatterURLBodyMap.put("matter_name",FormName);
createMatterURLBodyMap.put("questionnaire_id",SelectedQuestionnaireID);
createMatterURLContextMap = Map();
createMatterURLContextMap.put("other-system-id",MatterRecordID);
createMatterURLBodyMap.put("context",createMatterURLContextMap);
matterResponse = invokeurl
[
	url :createMatterURL
	type :POST
	body:createMatterURLBodyMap.toString()
	headers:createMatterURLHeadersMap
];
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// get the data from the created matter
matterID = matterResponse.get("id");
matterInviteKey = matterResponse.get("invite_key");
matterInviteURL = matterResponse.get("invite_url");
matterEventID = matterResponse.get("event_id");
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// get sublist of form info on matter page in zoho crm
UpdateDecisionVaultFormRecordMap = Map();
UpdateDecisionVaultFormRecordMap.put("Form_ID",matterID);
UpdateDecisionVaultFormRecordMap.put("Form_Invite_Key",matterInviteKey);
UpdateDecisionVaultFormRecordMap.put("Form_Invite_URL",matterInviteURL);
UpdateDecisionVaultFormRecordMap.put("Form_Status","Started");
UpdateDecisionVaultFormRecordResponse = zoho.crm.updateRecord("Decision_Vault_Forms",RecordID,UpdateDecisionVaultFormRecordMap);
info UpdateDecisionVaultFormRecordResponse;
}
