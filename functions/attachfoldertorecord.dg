string standalone.attachFolderToRecord(String module, String recordId, Map folderData, String crmBase)
{
attrs = folderData.get("attributes");
dataMap = Map();
dataMap.put("$link_url",attrs.get("permalink"));
dataMap.put("File_Name",attrs.get("name"));
dataMap.put("$resource_id",folderData.get("id"));
dataMap.put("$type","teamdrive");
dataList = List();
dataList.add(dataMap);
payload = "attachments=" + zoho.encryption.urlEncode({"data":dataList});
resp = invokeurl
[
	url :crmBase + "/" + module + "/" + recordId + "/Attachments"
	type :POST
	parameters:payload
	connection:"zcrm"
	content-type:"application/x-www-form-urlencoded"
];
info "Attach " + module + "/" + recordId + ": " + resp;
return resp.toString();
}
