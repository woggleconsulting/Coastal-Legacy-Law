string standalone.processSubfolders(String parentFolderId, String type, Bool isTopLevel)
{
externalFolderData = list();
externalFolderNames = list();
subfoldersList = list();
hasSubfolders = false;
header = Map();
header.put("Accept","application/vnd.api+json");
// ── Get all subfolders of the parent ──
subfolders = invokeurl
[
	url :"https://www.zohoapis.com/workdrive/api/v1/files/" + parentFolderId + "/folders"
	type :GET
	headers:header
	connection:"zworkdrive"
];
info {"subfolders":subfolders};
permissionsList = {"Editor":5,"View & Comment":6,"Upload":7,"Viewer":34};
if(subfolders.containsKey("data") && subfolders.get("data").size() > 0)
{
	hasSubfolders = true;
	for each  subfolder in subfolders.get("data")
	{
		subfolderId = subfolder.get("id");
		subfolderName = subfolder.get("attributes").get("name");
		if(isTopLevel)
		{
			// ── TOP LEVEL: Match by Matter Type data template ──
			subfolderMetadata = invokeurl
			[
				url :"https://www.zohoapis.com/workdrive/api/v1/files/" + subfolderId + "/custommetadata"
				type :GET
				headers:header
				connection:"zworkdrive"
			];
			info {"subfolderMetadata_" + subfolderName:subfolderMetadata};
			matched = false;
			if(subfolderMetadata.containsKey("data") && subfolderMetadata.get("data").size() > 0)
			{
				for each  dataTemplate in subfolderMetadata.get("data")
				{
					templateName = dataTemplate.get("attributes").get("name");
					info templateName.equals(type);
					info templateName;
					info type;
					if(templateName.equals(type))
					{
						matched = true;
					}
				}
			}
			if(matched)
			{
				data_param = Map();
				att_param = Map();
				att_param.put("resource_id",subfolderId);
				data_param.put("attributes",att_param);
				data_param.put("type","files");
				subfoldersList.add(data_param);
				// Also check for Client Permissions on the top-level folder
				if(subfolderMetadata.containsKey("data"))
				{
					for each  dataTemplate in subfolderMetadata.get("data")
					{
						if(dataTemplate.get("attributes").get("name").equals("Client Permissions"))
						{
							customData = dataTemplate.get("attributes").get("custom_data");
							for each  field in customData
							{
								if(field.get("display_name").equals("Permissions"))
								{
									permValue = field.get("value");
									if(!permValue.isNull() && !permValue.isEmpty() && !permValue.equals("N/A"))
									{
										externalFolderMap = Map();
										externalFolderMap.put("name",subfolderName);
										externalFolderMap.put("id",subfolderId);
										if(permissionsList.containsKey(permValue))
										{
											externalFolderMap.put("permissions",permissionsList.get(permValue));
											externalFolderMap.put("permission_formatted",permValue);
										}
										externalFolderData.add(externalFolderMap);
										externalFolderNames.add(subfolderName);
									}
								}
							}
						}
					}
				}
			}
		}
		else
		{
			// ── DEEPER LEVELS: Include all subfolders ──
			data_param = Map();
			att_param = Map();
			att_param.put("resource_id",subfolderId);
			data_param.put("attributes",att_param);
			data_param.put("type","files");
			subfoldersList.add(data_param);
			// ── Check for optional Client Permissions template ──
			subfolderMetadata = invokeurl
			[
				url :"https://www.zohoapis.com/workdrive/api/v1/files/" + subfolderId + "/custommetadata"
				type :GET
				headers:header
				connection:"zworkdrive"
			];
			info {"subfolderMetadata_" + subfolderName:subfolderMetadata};
			if(!subfolderMetadata.isNull() && subfolderMetadata.containsKey("data") && subfolderMetadata.get("data").size() > 0)
			{
				for each  dataTemplate in subfolderMetadata.get("data")
				{
					if(dataTemplate.get("attributes").get("name").equals("Client Permissions"))
					{
						customData = dataTemplate.get("attributes").get("custom_data");
						for each  field in customData
						{
							if(field.get("display_name").equals("Permissions"))
							{
								permValue = field.get("value");
								if(!permValue.isNull() && !permValue.isEmpty() && !permValue.equals("N/A"))
								{
									externalFolderMap = Map();
									externalFolderMap.put("name",subfolderName);
									externalFolderMap.put("id",subfolderId);
									if(permissionsList.containsKey(permValue))
									{
										externalFolderMap.put("permissions",permissionsList.get(permValue));
										externalFolderMap.put("permission_formatted",permValue);
									}
									externalFolderData.add(externalFolderMap);
									externalFolderNames.add(subfolderName);
								}
							}
						}
					}
				}
			}
		}
	}
}
responseMap = Map();
responseMap.put("subfoldersList",subfoldersList);
responseMap.put("externalFolderData",externalFolderData);
responseMap.put("externalFolderNames",externalFolderNames);
responseMap.put("has_folders",hasSubfolders);
return responseMap;
}
