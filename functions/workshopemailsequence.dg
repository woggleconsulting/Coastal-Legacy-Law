string standalone.workshopEmailSequence(Int recId, Int day)
{
//Global Values//
fromEmail = zoho.adminuserid;
//template ids
emailTemplateMap = Map();
emailTemplateMap.put(2,6994809000001324241);
emailTemplateMap.put(4,6994809000001324248);
emailTemplateMap.put(9,6994809000001324255);
emailTemplateMap.put(13,6994809000001324262);
//=========//
lead = zoho.crm.getRecordById("Leads",recId);
existingEvents = lead.get("Upcoming_Events");
relatedCampaigns = zoho.crm.getRelatedRecords("Campaigns","Leads",recId);
for each  existingEvent in existingEvents
{
	for each  relatedCampaign in relatedCampaigns
	{
		if(relatedCampaign.get("id") == existingEvent.get("Campaign_Name").get("id"))
		{
			membershipStatus = relatedCampaign.get("$member_info").get("Member_Status");
			campaignStartDateTime = relatedCampaign.get("Start_Date_and_Time");
		}
		if(campaignStartDateTime != null && campaignStartDateTime.toDateTime() > zoho.currenttime)
		{
			if(membershipStatus != "Canceled" && existingEvent.get("Sign_Up_Date") == zoho.currentdate.subDay(day).toString("yyyy-MM-dd"))
			{
				emailTemplate = emailTemplateMap.get(day);
				requestMap = Map();
				requestMap.put("from",{"email":zoho.adminuserid});
				requestMap.put("to",{{"email":lead.get("Email")}});
				requestMap.put("template",{"id":emailTemplate});
				requestPayload = {"data":{requestMap}};
				sendEmail = invokeurl
				[
					url :"https://www.zohoapis.com/crm/v8/Leads/" + recId + "/actions/send_mail"
					type :POST
					parameters:requestPayload.toString()
					connection:"zcrm"
				];
				info {"sendEmail":sendEmail};
			}
		}
	}
}
return "";
}
