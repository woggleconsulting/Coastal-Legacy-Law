string standalone.createWorkdriveFolders(Int recordId)
{
orgId = zoho.crm.getOrgVariable("zworkdrive_orgId");
groups = zoho.crm.getOrgVariable("zworkdrive_groups");
templateFolderId = zoho.crm.getOrgVariable("zworkdrive_templateFolderId");
password = zoho.encryption.md5(zoho.currenttime).subString(0,8);
recordExternalFolderList = list();
//
header = Map();
header.put("Accept","application/vnd.api+json");
//----------//
recordDetails = zoho.crm.getRecordById("Deals",recordId);
recordFolderId = recordDetails.get("zworkdrive_folderID");
//READ IN ACCCOUNT DATA//
accountId = recordDetails.get("Account_Name").get("id");
accountDetails = zoho.crm.getRecordById("Accounts",accountId);
accountFolderId = accountDetails.get("zworkdrive_folderID");
/*
//READ IN CONTACT DATA//
contactId = recordDetails.get("Contact_Name").get("id");
contactDetails = zoho.crm.getRecordById("Contacts",contactId);
contactFolderId = contactDetails.get("zworkdrive_folderID");
*/
//ACTION 1: Create Account folder (team folder) if one does not exist
if(accountFolderId.isNull())
{
	//CREATE ACCOUNT FOLDER//
	createAccountFolder = zoho.workdrive.createTeamFolder(accountDetails.get("Account_Name"),orgId,"",false,"zworkdrive");
	info {"createAccountFolder":createAccountFolder};
	folderData_account = createAccountFolder.get("data");
	accountFolderId = folderData_account.get("id");
	//ATTACH FOLDER TO ACCOUNT//
	dataList_account = List();
	data_account = Map();
	data_account.put("$link_url",folderData_account.get("attributes").get("permalink"));
	data_account.put("File_Name",folderData_account.get("attributes").get("name"));
	data_account.put("$resource_id",accountFolderId);
	data_account.put("$type","teamdrive");
	dataList_account.add(data_account);
	payload_account = "attachments=" + zoho.encryption.urlEncode({"data":dataList_account});
	attachFile_account = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v2.1/Accounts/" + accountId + "/Attachments"
		type :POST
		parameters:payload_account
		connection:"zcrm"
		content-type:"application/x-www-form-urlencoded"
	];
	updateAccount = zoho.crm.updateRecord("Accounts",accountId,{"zworkdrive_folderID":accountFolderId});
}
//----------//
/*
//Skipping Contact folder. Only create a Matter folder under each Account (file)
//ACTION 2: Create Contact folder if one does not exist
if(contactFolderId.isNull())
{
	//CREATE CONTACT FOLDER//
	createContactFolder = zoho.workdrive.createFolder(contactDetails.get("Full_Name"),accountFolderId,"zworkdrive");
	info {"createContactFolder":createContactFolder};
	folderData_contact = createContactFolder.get("data");
	contactFolderId = folderData_contact.get("id");
	//ATTACH FOLDER TO ACCOUNT//
	dataList_contact = List();
	data_contact = Map();
	data_contact.put("$link_url",folderData_contact.get("attributes").get("permalink"));
	data_contact.put("File_Name",folderData_contact.get("attributes").get("name"));
	data_contact.put("$resource_id",contactFolderId);
	data_contact.put("$type","teamdrive");
	dataList_contact.add(data_contact);
	payload_contact = "attachments=" + zoho.encryption.urlEncode({"data":dataList_contact});
	attachFile_contact = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v2.1/Contacts/" + contactId + "/Attachments"
		type :POST
		parameters:payload_contact
		connection:"zcrm"
		content-type:"application/x-www-form-urlencoded"
	];
	updateContact = zoho.crm.updateRecord("Contacts",contactId,{"zworkdrive_folderID":contactFolderId});
}
//---------//
*/
//ACTION 3: Create Matter folder
if(recordFolderId.isNull())
{
	createRecordFolder = zoho.workdrive.createFolder(recordDetails.get("Deal_Name"),accountFolderId,"zworkdrive");
	info {"createRecordFolder":createRecordFolder};
	folderData_record = createRecordFolder.get("data");
	recordFolderId = folderData_record.get("id");
	updateRecord = zoho.crm.updateRecord("Deals",recordId,{"zworkdrive_folderID":recordFolderId});
	//ATTACH FOLDER TO RECORD//
	dataList_record = List();
	data_record = Map();
	data_record.put("$link_url",folderData_record.get("attributes").get("permalink"));
	data_record.put("File_Name",folderData_record.get("attributes").get("name"));
	data_record.put("$resource_id",recordFolderId);
	data_record.put("$type","teamdrive");
	dataList_record.add(data_record);
	payload_record = "attachments=" + zoho.encryption.urlEncode({"data":dataList_record});
	attachFile_record = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v2.1/Deals/" + recordId + "/Attachments"
		type :POST
		parameters:payload_record
		connection:"zcrm"
		content-type:"application/x-www-form-urlencoded"
	];
}
if(!recordDetails.get("Type").isNull())
{
	//----------//
	//ACTION 4: Copy folder template
	folderLevels = 20;
	templateSubfolders = invokeurl
	[
		url :"https://www.zohoapis.com/workdrive/api/v1/teamfolders/" + templateFolderId + "/folders"
		type :GET
		headers:header
		connection:"zworkdrive"
	];
	//info {"templateSubfolders":templateSubfolders};
	if(templateSubfolders.containsKey("data") && templateSubfolders.get("data").size() > 0)
	{
		dataList_subFolders = list();
		externalFolderData = list();
		externalFolderNames = list();
		// Process initial folders
		info templateFolderId;
		info recordDetails.get("Type");
		processSubfolders_initial = standalone.processSubfolders(templateFolderId,recordDetails.get("Type"),true).toMap();
		info {"processSubfolders_initial":processSubfolders_initial};
		if(!processSubfolders_initial.isNull())
		{
			hasSubfolders = processSubfolders_initial.get("has_folders");
			externalFolderData.addAll(processSubfolders_initial.get("externalFolderData"));
			externalFolderNames.addAll(processSubfolders_initial.get("externalFolderNames"));
			dataList_subFolders.addAll(processSubfolders_initial.get("subfoldersList"));
		}
		// Process additional levels — BFS
		currentLevel = list();
		for each  folder in dataList_subFolders
		{
			currentLevel.add(folder.get("attributes").get("resource_id"));
		}
		copySubfolderLevels = "".leftPad(folderLevels).replaceAll(" ",",").toList().subList(0,folderLevels);
		for each  copySubfolder in copySubfolderLevels
		{
			if(currentLevel.size() == 0)
			{
				break;
			}
			nextLevel = list();
			for each  parentId in currentLevel
			{
				processSubfolders_secondary = standalone.processSubfolders(parentId,recordDetails.get("Type"),false).toMap();
				if(!processSubfolders_secondary.isNull())
				{
					externalFolderData.addAll(processSubfolders_secondary.get("externalFolderData"));
					externalFolderNames.addAll(processSubfolders_secondary.get("externalFolderNames"));
					//dataList_subFolders.addAll(processSubfolders_secondary.get("subfoldersList"));
					// Queue children for next level
					if(processSubfolders_secondary.get("has_folders"))
					{
						for each  childFolder in processSubfolders_secondary.get("subfoldersList")
						{
							nextLevel.add(childFolder.get("attributes").get("resource_id"));
						}
					}
				}
			}
			currentLevel = nextLevel;
		}
		// Copy the folders
		copySubfolderParams = {"data":dataList_subFolders};
		copySubfolder = invokeurl
		[
			url :"https://www.zohoapis.com/workdrive/api/v1/files/" + recordFolderId + "/copy"
			type :POST
			parameters:copySubfolderParams.toString()
			headers:header
			connection:"zworkdrive"
		];
		// ACTION 5: Create external share links
		if(externalFolderData.size() > 0 && !copySubfolder.isNull())
		{
			folderNameToIdMap = Map();
			// First level
			for each  subfolder in copySubfolder.get("data")
			{
				subfolderName = subfolder.get("attributes").get("name");
				subFolderId = subfolder.get("id");
				folderNameToIdMap.put(subfolderName,subFolderId);
			}
			// Additional levels
			folderMap = Map();
			firstLevelIds = list();
			for each  subfolder in copySubfolder.get("data")
			{
				firstLevelIds.add(subfolder.get("id"));
			}
			folderMap.put("iteration1Ids",firstLevelIds);
			try 
			{
				getUrl("https://httpstat.us/200?sleep=5000");
			}
			catch (err)
			{
				info "Pause Function Timeout Error: " + err;
			}
			maxLevelLoops = "".leftPad(folderLevels).replaceAll(" ",",").toList().subList(0,folderLevels);
			count = 1;
			for each  level in maxLevelLoops
			{
				currentLevelIds = list();
				for each  subFolderId in folderMap.get("iteration" + count + "Ids")
				{
					addlSubFolders = invokeurl
					[
						url :"https://www.zohoapis.com/workdrive/api/v1/files/" + subFolderId + "/folders"
						type :GET
						headers:header
						connection:"zworkdrive"
					];
					if(addlSubFolders.get("data").size() > 0)
					{
						for each  addlSubFolder in addlSubFolders.get("data")
						{
							subfolderName = addlSubFolder.get("attributes").get("name");
							subFolderId = addlSubFolder.get("id");
							currentLevelIds.add(subFolderId);
							// Only add to map if not already present (first occurrence wins)
							if(!folderNameToIdMap.containsKey(subfolderName))
							{
								folderNameToIdMap.put(subfolderName,subFolderId);
							}
						}
					}
				}
				if(currentLevelIds.size() > 0)
				{
					count = count + 1;
					folderMap.put("iteration" + count + "Ids",currentLevelIds);
				}
				else
				{
					break;
				}
			}
			// Now create external links only for folders that match external folder names
			for each  externalFolderName in externalFolderNames
			{
				if(folderNameToIdMap.containsKey(externalFolderName))
				{
					folderId = folderNameToIdMap.get(externalFolderName);
					externalFolder = externalFolderData.get(externalFolderNames.indexOf(externalFolderName));
					// Create external link payload
					el_dataMap = Map();
					el_attributeMap = Map();
					// User data configuration
					el_requestUserData = false;
					userDataValues = {"Name"};
					if(el_requestUserData)
					{
						el_inputFieldsList = List();
						if(userDataValues.contains("Name"))
						{
							el_inputFieldsMap_name = Map();
							el_inputFieldsMap_name.put("field_name","Name");
							el_inputFieldsMap_name.put("field_type","TEXT");
							el_inputFieldsMap_name.put("is_name_field","true");
							el_inputFieldsList.add(el_inputFieldsMap_name);
						}
						if(userDataValues.contains("Phone"))
						{
							el_inputFieldsMap_phone = Map();
							el_inputFieldsMap_phone.put("field_name","Phone");
							el_inputFieldsMap_phone.put("field_type","PHONE");
							el_inputFieldsList.add(el_inputFieldsMap_phone);
						}
						if(userDataValues.contains("Email"))
						{
							el_inputFieldsMap_email = Map();
							el_inputFieldsMap_email.put("field_name","Email");
							el_inputFieldsMap_email.put("field_type","EMAIL_ID");
							el_inputFieldsList.add(el_inputFieldsMap_email);
							el_attributeMap.put("input_fields",el_inputFieldsList);
						}
					}
					// Link configuration
					el_allowDownload = true;
					el_password = password;
					el_role = externalFolder.get("permissions");
					el_expirationDate = zoho.currentdate.addMonth(1).toString("YYYY-MM-dd");
					// Build payload
					el_attributeMap.put("resource_id",folderId);
					el_attributeMap.put("link_name","External Share Link");
					el_attributeMap.put("allow_download",el_allowDownload);
					el_attributeMap.put("password_text",el_password);
					el_attributeMap.put("request_user_data",el_requestUserData);
					el_attributeMap.put("role_id",el_role);
					//el_attributeMap.put("expiration_date",el_expirationDate);
					el_dataMap.put("attributes",el_attributeMap);
					el_dataMap.put("type","links");
					el_payload = {"data":el_dataMap};
					try 
					{
						createExternalShareLink = invokeurl
						[
							url :"https://www.zohoapis.com/workdrive/api/v1/links"
							type :POST
							parameters:el_payload.toString()
							headers:header
							connection:"zworkdrive"
						];
						if(!createExternalShareLink.isNull() && createExternalShareLink.get("data") != null)
						{
							externalShareLink = createExternalShareLink.get("data").get("attributes").get("link");
							recordExternalFolders = Map();
							recordExternalFolders.put("Folder_Name",externalFolderName);
							recordExternalFolders.put("Folder_Link",externalShareLink);
							recordExternalFolders.put("Folder_Permissions",externalFolder.get("permission_formatted"));
							recordExternalFolderList.add(recordExternalFolders);
						}
					}
					catch (e)
					{
						info "Error creating external share link for " + externalFolderName + ": " + e;
					}
				}
			}
		}
	}
	// Update CRM record with external folders
	if(recordExternalFolderList.size() > 0)
	{
		updateRecord_externalFoldersMap = Map();
		updateRecord_externalFoldersMap.put("Password",password);
		updateRecord_externalFoldersMap.put("External_Folders",recordExternalFolderList);
		updateRecord_externalFolders = zoho.crm.updateRecord("Deals",recordId,updateRecord_externalFoldersMap);
		info "Updated CRM with " + recordExternalFolderList.size() + " external folders";
	}
	else
	{
		info "No matching external folders found";
	}
}
//Add/Update Groups to Account Folder//
//Add all groups to folder. See Global Variables
for each  group in groups
{
	groupId = orgId + "-" + group.get("groupId");
	roleId = group.get("roleId");
	data = Map();
	data_param2 = Map();
	att_param2 = Map();
	att_param2.put("resource_id",accountFolderId);
	att_param2.put("shared_type","groupmembers");
	att_param2.put("share_to",groupId);
	att_param2.put("role_id",roleId);
	data_param2.put("attributes",att_param2);
	data_param2.put("type","members");
	data.put("data",data_param2);
	addGroup = invokeurl
	[
		url :"https://www.zohoapis.com/workdrive/api/v1/members"
		type :POST
		parameters:data.toString()
		headers:header
		connection:"zworkdrive"
	];
	info {"groupId":groupId,"addGroup":addGroup};
}
// Create a structured XML response with all relevant information
responseMap = Map();
responseMap.put("status","success");
responseMap.put("accountFolderId",accountFolderId);
//responseMap.put("contactFolderId",contactFolderId);
if(!recordDetails.get("zworkdrive_folderID").isNull())
{
	responseMap.put("recordFolderId",recordDetails.get("zworkdrive_folderID"));
	responseMap.put("message","Existing folders used");
}
else if(!recordFolderId.isNull())
{
	responseMap.put("recordFolderId",recordFolderId);
	responseMap.put("message","New folders created");
	// Add external folder information if applicable
	if(recordExternalFolderList.size() > 0)
	{
		externalFolders = List();
		for each  folder in recordExternalFolderList
		{
			externalFolder = Map();
			externalFolder.put("name",folder.get("Folder_Name"));
			externalFolder.put("link",folder.get("Folder_Link"));
			externalFolder.put("permissions",folder.get("Folder_Permissions"));
			externalFolders.add(externalFolder);
		}
		responseMap.put("externalFolders",externalFolders);
		responseMap.put("password",password);
	}
}
else
{
	responseMap.put("status","error");
	responseMap.put("message","Failed to create folders");
}
reponse = Map();
reponse.put("Content-Type","application/json");
reponse.put("body",responseMap);
return {"crmAPIResponse":reponse};
}
