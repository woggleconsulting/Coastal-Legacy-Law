void automation.leads_associateSpouses(Int recId)
{
leadRecord = zoho.crm.getRecordById("Leads",recId);
spouseLookup = leadRecord.get("Spouse_Partner");
if(spouseLookup != null)
{
	spouseId = spouseLookup.get("id");
	spouseRecord = zoho.crm.getRecordById("Leads",spouseId);
	spouseUpdate = Map();
	// --- PART 1: Protect Married status ---
	if(spouseRecord.get("Marital_Status") != "Married")
	{
		spouseUpdate.put("Marital_Status",leadRecord.get("Marital_Status"));
	}
	// Ensure spouse links back
	if(spouseRecord.get("Spouse_Partner") == null || spouseRecord.get("Spouse_Partner").get("id") != recId)
	{
		spouseUpdate.put("Spouse_Partner",recId);
	}
	if(spouseUpdate.size() > 0)
	{
		zoho.crm.updateRecord("Leads",spouseId,spouseUpdate,{"trigger":{"workflow"}});
	}
	// --- PART 2: NEW LOGIC ---
	// If current record is "Spouse of Client"
	if(leadRecord.get("Lead_Type") == "Spouse of Client")
	{
		inquirerLookup = spouseRecord.get("Inquirer_Lead");
		if(inquirerLookup != null)
		{
			currentUpdate = Map();
			currentUpdate.put("Inquirer_Lead",inquirerLookup.get("id"));
			zoho.crm.updateRecord("Leads",recId,currentUpdate,{"trigger":{"workflow"}});
		}
	}
}
}
