void automation.meetings_handleMeetingStatusChange1(int meetingId)
{
meeting = zoho.crm.getRecordById("Events",meetingId);
status = meeting.get("Meeting_Status");
meetingType = meeting.get("Meeting_Type");
fileId = meeting.get("What_Id").get("id");
contactId = meeting.get("Who_Id").get("id");
contactRec = zoho.crm.getRecordById("Contacts",contactId);
matterRec = zoho.crm.getRelatedRecords("Deals","Contacts",contactId);
matterId = matterRec.get("0").get("id");
lastProcessed = meeting.get("Last_Processed_Status");
info fileId;
if(lastProcessed == status)
{
	return;
}
if(status == "Canceled")
{
	if(matterId != null)
	{
		// Create task
		taskMap = Map();
		taskMap.put("Subject","Follow up on canceled " + meetingType);
		taskMap.put("Due_Date",zoho.currentdate.addDay(3));
		taskMap.put("Who_Id",contactId);
		taskMap.put("What_Id",matterId);
		taskMap.put("Status","Not Started");
		taskMap.put("Priority","High");
		taskMap.put("$se_module","Deals");
		taskResp = zoho.crm.createRecord("Tasks",taskMap);
	}
}
else if(status == "Completed")
{
	if(matterId != null)
	{
		stageMap = Map();
		stageMap.put("LLPS","Engaged");
		// Put New Meetings that should change Stage when completed here
		/* Example: stageMap.put("[Meeting Type in Meeting record]", "[Stage to be set in Matter record]"); */
		if(stageMap.containsKey(meetingType))
		{
			matter = zoho.crm.getRecordById("Deals",matterId);
			if(matter != null)
			{
				currentStage = matter.get("Stage");
				excludedStages = {"Deceased","No Longer Client","DNE"};
				if(!excludedStages.contains(currentStage))
				{
					updateMap = Map();
					updateMap.put("Stage",stageMap.get(meetingType));
					updateResp = zoho.crm.updateRecord("Deals",matterId,updateMap);
				}
			}
		}
	}
}
updateMap = Map();
updateMap.put("Last_Processed_Status",status);
updateResp = zoho.crm.updateRecord("Events",meetingId,updateMap);
return;
}
