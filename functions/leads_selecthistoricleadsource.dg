void automation.leads_selectHistoricLeadSource(Int leadId)
{
//checking on the need for these automation flags//
leadRecord = zoho.crm.getRecordById("Leads",leadId);
leadSource = leadRecord.get("Lead_Source");
updateMap = Map();
if(leadSource == "Web Download")
{
	updateMap.put("Web_Download",true);
}
else if(leadSource == "Website Form Filled")
{
	updateMap.put("Website_Form_Filled",true);
}
else if(leadSource == "Workshop")
{
	updateMap.put("Workshop",true);
}
if(updateMap.size() > 0)
{
	response = zoho.crm.updateRecord("Leads",leadId,updateMap);
}
}
