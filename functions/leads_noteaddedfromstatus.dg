void automation.leads_noteAddedFromStatus(int leadId)
{
lead = zoho.crm.getRecordById("Leads",leadId);
firstName = ifnull(lead.get("First_Name"),"Lead");
leadStatus = lead.get("Lead_Status");
campaign = "";
if(lead.get("Associated_Campaign") != null)
{
	campaign = lead.get("Associated_Campaign").get("name");
}
noteContent = "";
if(campaign != "")
{
	noteContent = firstName + " " + leadStatus + " for " + campaign;
}
else
{
	noteContent = firstName + " " + leadStatus + " for " + "Call/Meeting";
}
noteMap = Map();
noteMap.put("Note_Title","Status Update");
noteMap.put("Note_Content",noteContent);
noteMap.put("Parent_Id",leadId);
noteMap.put("se_module","Leads");
createNote = zoho.crm.createRecord("Notes",noteMap);
}
