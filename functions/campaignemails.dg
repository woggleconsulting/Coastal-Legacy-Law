void schedule.campaignEmails()
{
templateMap = Map();
templateMap.put("Day_1",12345);
templateMap.put("Day_Before",12345);
//=========//
/*
1. Use COQL to get all Leads associated with an upcoming campaign. Might be able to use the cvid below (Custom View ID).
2. Create list of Leads to send emails to
3. Determine which emails should be sent based on when Lead was created (ideally when lead was added to campaign if that's possible)
4. Send appropriate email
*/
campaignResponse = zoho.crm.getRecords("Campaigns",1,200,{"cvid":"6994809000001318090"});
for each  campaign in campaignResponse
{
	getCampaignLeads = zoho.crm.getRelatedRecords("Leads","Campaigns",campaign.get("id"));
	emailList = list();
	for each  lead in getCampaignLeads
	{
		if(lead.get("$member_info").get("Member_Status") != "Canceled")
		{
			emailList.add(lead.get("Email"));
		}
	}
	info emailList;
	if(campaign.get("Start_Date") == zoho.currentdate.addDay(1))
	{
		//Send day before email//
		//Use Send Mail API//
		templateId = templateMap.get("Day_Before");
	}
}
info getCampaignLeads;
}
