void automation.meetings_syncWithMatter(Int meetingId)
{
info "################################################################";
info "--- SYNCING MEETING TO MATTER: " + meetingId + " ---";
info "################################################################";
// Get meeting record
meeting = zoho.crm.getRecordById("Events",meetingId);
if(meeting == null)
{
	info "ERROR: Meeting not found";
	return;
}
meetingTitle = ifnull(meeting.get("Event_Title"),"");
meetingStatus = ifnull(meeting.get("Meeting_Status"),"");
meetingType = ifnull(meeting.get("Meeting_Type"),"");
startDateTime = meeting.get("Start_DateTime");
info "Meeting Title: " + meetingTitle;
info "Meeting Status: " + meetingStatus;
info "Meeting Type: " + meetingType;
info "Start DateTime: " + startDateTime;
// Extract date from datetime (format: YYYY-MM-DD)
meetingDate = null;
if(startDateTime != null && startDateTime != "")
{
	meetingDate = startDateTime.toString("yyyy-MM-dd");
	info "Extracted Date: " + meetingDate;
}
// ================================================================
// STEP 1: CHECK IF MEETING IS RELATED TO A LEAD
// ================================================================
whatId = meeting.get("What_Id");
if(whatId != null)
{
	seModule = meeting.get("$se_module");
	if(seModule == "Leads")
	{
		info "Meeting is related to a LEAD - skipping Matter association and date updates";
		info "Lead ID: " + whatId.get("id");
		return;
	}
}
// ================================================================
// STEP 2: GATHER AND DEDUPLICATE CONTACT PARTICIPANTS
// ================================================================
matterId = null;
contactId = null;
contactIds = List();
// Check primary contact (Who_Id)
whoId = meeting.get("Who_Id");
if(whoId != null)
{
	contactIds.add(whoId.get("id").toString());
}
// Pull additional participants from the meeting array
participants = meeting.get("Participants");
info "Participants: " + participants;
if(participants != null && participants.size() > 0)
{
	for each  participant in participants
	{
		pType = ifnull(participant.get("type"),"");
		pContactId = participant.get("participant");
		// Only extract if participant type is a Contact
		if(pType.equalsIgnoreCase("contact") && pContactId != null)
		{
			contactIds.add(pContactId.toString());
		}
	}
}
// Deduplicate contact IDs
uniqueContactIds = contactIds.distinct();
info "Resolved Unique Contact IDs to process: " + uniqueContactIds;
if(uniqueContactIds.size() == 0)
{
	info "No valid Contact participants found. Exiting sync.";
	return;
}
// ================================================================
// STEP 3: RESOLVE ALL RELATED MATTERS (DEALS)
// ================================================================
matterIds = List();
// If the meeting is already directly related to a Deal, ensure it's in the list
if(whatId != null && meeting.get("$se_module") == "Deals")
{
	matterIds.add(whatId.get("id").toString());
}
// Find all matters related to all unique contacts found
for each  contactId in uniqueContactIds
{
	dealsResp = zoho.crm.getRelatedRecords("Deals","Contacts",contactId.toLong());
	if(dealsResp != null && dealsResp.size() > 0)
	{
		for each  deal in dealsResp
		{
			if(deal.get("id") != null)
			{
				matterIds.add(deal.get("id").toString());
			}
		}
	}
}
uniqueMatterIds = matterIds.distinct();
info "Total Unique Matters found across all participants: " + uniqueMatterIds;
if(uniqueMatterIds.size() == 0)
{
	info "No related Matters found for any participant. Skipping field updates.";
	return;
}
// ================================================================
// STEP 4: DETERMINE FIELD MAPPINGS
// ================================================================
dateFieldMap = Map();
dateFieldMap.put("Legal Life Planning Session","LLPS_Meeting");
dateFieldMap.put("LLPS","LLPS_Meeting");
dateFieldMap.put("Estate Plan Design Meeting","Design_Meeting_Date");
dateFieldMap.put("Design Meeting","Design_Meeting_Date");
dateFieldMap.put("CIMI","CIMI_Review_Date_Time");
dateFieldMap.put("Signing","Signing_Meeting");
dateFieldMap.put("Funding","Funding_Meeting");
fieldToUpdate = null;
matchedKey = null;
// Check Event_Title first
for each  key in dateFieldMap.keys()
{
	info "Checking meeting title against keys. Title: " + meetingTitle;
	if(meetingTitle.containsIgnoreCase(key))
	{
		fieldToUpdate = dateFieldMap.get(key);
		matchedKey = key;
		info "Matched Event_Title '" + meetingTitle + "' to field: " + fieldToUpdate;
		break;
	}
}
// If no match in title, check Meeting_Type
if(fieldToUpdate == null && meetingType != "")
{
	for each  key in dateFieldMap.keys()
	{
		if(meetingType.containsIgnoreCase(key))
		{
			fieldToUpdate = dateFieldMap.get(key);
			matchedKey = key;
			info "Matched Meeting_Type '" + meetingType + "' to field: " + fieldToUpdate;
			break;
		}
	}
}
if(fieldToUpdate == null)
{
	info "No date field mapping found for this meeting title/type.";
	return;
}
// Check category tags
isLLPS = matchedKey.contains("Legal Life Planning Session") || matchedKey.contains("LLPS");
isDesignMeeting = matchedKey.contains("Design Meeting");
// Build target update map payload
updateMatterMap = Map();
shouldClearDate = false;
if(meetingStatus == "Cancelled" || meetingStatus == "Canceled" || meetingStatus == "Rescheduled")
{
	info "Meeting status is " + meetingStatus + " - preparing to clear fields.";
	shouldClearDate = true;
	if(isLLPS)
	{
		updateMatterMap.put("LLPS_Status",null);
	}
	else if(isDesignMeeting)
	{
		updateMatterMap.put("Design_Meeting_Status",null);
	}
}
else if(meetingStatus == "Completed" || meetingStatus == "Booked")
{
	if(startDateTime != null)
	{
		if(matchedKey == "Funding" || fieldToUpdate == "CIMI_Review_Date_Time")
		{
			updateMatterMap.put(fieldToUpdate,startDateTime);
		}
		else if(meetingDate != null)
		{
			updateMatterMap.put(fieldToUpdate,meetingDate);
		}
	}
	if(isLLPS)
	{
		if(meetingStatus == "Booked")
		{
			updateMatterMap.put("LLPS_Status","Booked");
		}
		else if(meetingStatus == "Completed")
		{
			updateMatterMap.put("LLPS_Status","Completed");
			updateMatterMap.put("Engaged","Yes");
		}
	}
	else if(isDesignMeeting)
	{
		if(meetingStatus == "Booked")
		{
			updateMatterMap.put("Design_Meeting_Status","Booked");
		}
	}
}
else
{
	info "Meeting status '" + meetingStatus + "' does not trigger date update.";
	return;
}
if(shouldClearDate)
{
	updateMatterMap.put(fieldToUpdate,null);
}
// ================================================================
// STEP 5: EXECUTE BATCH UPDATES FOR ALL RELEVANT MATTERS
// ================================================================
if(updateMatterMap.size() > 0)
{
	for each  matterId in uniqueMatterIds
	{
		info "Updating Matter ID: " + matterId + " with payload: " + updateMatterMap;
		matterUpdateResp = zoho.crm.updateRecord("Deals",matterId.toLong(),updateMatterMap);
		info "Result for Matter " + matterId + ": " + matterUpdateResp;
	}
	info "SUCCESS: All mapped Matter records synchronized.";
}
else
{
	info "No Matter fields prepared for update.";
}
info "################################################################";
info "--- END OF MULTI-SYNC ---";
info "################################################################";
}
