void automation.leads_stopFollowUpEmails(Int leadId)
{
//This function will check a box on all existing meetings for a lead to stop any follow up emails. This happens when the lead is moved to LLPS Not Booked or Did Not Engage. See workflow https://crm.zoho.com/crm/org900790674/settings/workflow-rules/6994809000001142198 for how this feature is used//
leadRecord = zoho.crm.getRecordById("Leads",leadId).get("Lead_Status");
info leadRecord;
if(leadRecord == "LLPS Not Booked" || leadRecord == "Did Not Engage")
{
	meetingRecords = zoho.crm.getRelatedRecords("Invited_Events","Leads",leadId);
	for each  meeting in meetingRecords
	{
		meetingId = meeting.get("id");
		meetingRecord = zoho.crm.getRecordById("Events",meetingId);
		updateMap = Map();
		updateMap.put("Stop_Follow_Up_Emails",true);
		updateStopEmails = zoho.crm.updateRecord("Events",meetingId,updateMap);
		info meetingRecord;
	}
}
}
