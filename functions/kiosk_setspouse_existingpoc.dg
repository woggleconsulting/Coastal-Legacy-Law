void automation.kiosk_setSpouse_existingPOC(int clientId, int spouseId)
{
spouseIdLong = spouseId.toLong();
updateMap = Map();
updateMap.put("Spouse_Partner",spouseIdLong);
responseClient = zoho.crm.updateRecord("Leads",clientId,updateMap);
clientIdLong = clientId.toLong();
updateMap = Map();
updateMap.put("Spouse_Partner",clientIdLong);
responseSpouse = zoho.crm.updateRecord("Leads",spouseId,updateMap);
info responseSpouse;
info responseClient;
}
