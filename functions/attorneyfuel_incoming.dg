string standalone.attorneyFuel_incoming(Map crmAPIRequest)
{
requestBody = crmAPIRequest.get("body");
//requestBody = {"id":"2FGufxdyyYb1ozUH3jFO","name":"Jhonas","email":"demo2@woggleconsulting.com","phone":"+63 951 471 4561","permission to text":"Yes","street Address":"Test","state":"Test","city":"Test","country":"Test","postalCode":"Test","callingOnBehalfOf":"Test","howDidYouHearAboutUs?":"Previous Client","referredTo":"Test","ifReferralAddTheNameBelow":"Test","ifPreviousClientPleaseSpecify":"Test","couldYouPleaseSpecifyWhereYouHeardAboutUs?":"Test","caseType":"Elder Law","notes":"Notes Test","intakeSpecialist":"Amy","consultSetWith":"Alexis Merzoyan","whatWasTheReasonForYourDisqualificationDuringIntake?":"Test","whatWasTheReasonForYourDisqualificationDuringTheConsultation?":"Test","reasonForConsultNotSet":"Test","reasonForNotRetained":"Test"};
bodyMap = requestBody;
info bodyMap;
afId = bodyMap.get("id");
fullName = bodyMap.get("name");
email = bodyMap.get("email");
phone = bodyMap.get("phone");
street = bodyMap.get("street Address");
state = bodyMap.get("state");
city = bodyMap.get("city");
country = bodyMap.get("country");
zip = bodyMap.get("postalCode");
subLeadSource = bodyMap.get("couldYouPleaseSpecifyWhereYouHeardAboutUs?");
caseType = bodyMap.get("caseType");
leadSource = bodyMap.get("howDidYouHearAboutUs?");
intakeSpec = bodyMap.get("intakeSpecialist");
notesContent = bodyMap.get("notes");
firstName = "";
lastName = "";
if(fullName != null && fullName.trim() != "" && fullName.trim() != "null")
{
	cleanName = fullName.trim();
	spaceIndex = cleanName.lastIndexOf(" ");
	if(spaceIndex > -1)
	{
		firstName = cleanName.subString(0,spaceIndex);
		lastName = cleanName.subString(spaceIndex + 1);
	}
	else
	{
		lastName = cleanName;
	}
}
leadData = Map();
if(afId != null && afId.trim() != "" && afId.trim() != "null")
{
	leadData.put("Attorney_Fuel_Id",afId);
}
if(firstName != null && firstName.trim() != "" && firstName.trim() != "null")
{
	leadData.put("First_Name",firstName);
}
if(lastName != null && lastName.trim() != "" && lastName.trim() != "null")
{
	leadData.put("Last_Name",lastName);
}
if(email != null && email.trim() != "" && email.trim() != "null")
{
	leadData.put("Email",email);
}
if(phone != null && phone.trim() != "" && phone.trim() != "null")
{
	leadData.put("Phone",phone);
}
if(street != null && street.trim() != "" && street.trim() != "null")
{
	leadData.put("Street",street);
}
if(state != null && state.trim() != "" && state.trim() != "null")
{
	leadData.put("State",state);
}
if(city != null && city.trim() != "" && city.trim() != "null")
{
	leadData.put("City",city);
}
if(country != null && country.trim() != "" && country.trim() != "null")
{
	leadData.put("Country",country);
}
if(zip != null && zip.trim() != "" && zip.trim() != "null")
{
	leadData.put("Zip_Code",zip);
}
if(subLeadSource != null && subLeadSource.trim() != "" && subLeadSource.trim() != "null")
{
	leadData.put("Sub_Lead_Source",subLeadSource);
}
if(caseType != null && caseType.trim() != "" && caseType.trim() != "null")
{
	leadData.put("Pipeline",caseType);
}
if(leadSource != null && leadSource.trim() != "" && leadSource.trim() != "null")
{
	leadData.put("Lead_Source",leadSource);
}
if(intakeSpec != null && intakeSpec.trim() != "" && intakeSpec.trim() != "null")
{
	usersResp = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v2/users?type=ActiveUsers"
		type :GET
		connection:"zcrm"
	];
	for each  user in usersResp.get("users")
	{
		if(user.get("full_name") == intakeSpec || user.get("first_name") == intakeSpec)
		{
			leadData.put("Owner",user.get("id"));
			break;
		}
	}
}
leadId = "";
if(email != null && email.trim() != "" && email.trim() != "null")
{
	existingLeads = zoho.crm.searchRecords("Leads","(Email:equals:" + email + ")");
	if(existingLeads != null && existingLeads.size() > 0)
	{
		leadId = existingLeads.get(0).get("id");
		updateResp = zoho.crm.upsert("Leads",leadData);
		info "UPDATE: " + updateResp;
	}
	else
	{
		createResp = zoho.crm.upsert("Leads",leadData);
		info "CREATE: " + createResp;
		leadId = createResp.get("id");
	}
}
if(leadId != null && leadId != "" && notesContent != null && notesContent.trim() != "" && notesContent.trim() != "null")
{
	noteData = Map();
	noteData.put("Note_Title","Attorney Fuel Intake");
	noteData.put("Note_Content",notesContent);
	noteData.put("Parent_Id",leadId);
	noteData.put("se_module","Leads");
	noteResp = zoho.crm.createRecord("Notes",noteData);
	info "NOTE: " + noteResp;
}
return "Processed lead: " + email;
}
