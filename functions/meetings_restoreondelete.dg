void automation.meetings_RestoreOnDelete(String event_id)
{
info "--- TRIGGERED RESTORE ON DELETE ---";
info "Event ID to Restore: " + event_id;
// 1. RESTORE the specific ID from Recycle Bin
// We use the 'zoho_crm' connection which MUST have 'ZohoCRM.settings.recycle_bin.UPDATE' scope
restore_url = "https://www.zohoapis.com/crm/v2/settings/recycle_bin/" + event_id + "/actions/restore";
restore_res = invokeurl
[
	url :restore_url
	type :POST
	connection:"zoho_crm"
];
info "Restore Response: " + restore_res;
// 2. If restore was successful, ensure status is 'Cancelled'
// We check if the response contains 'success' status
if(restore_res.get("recycle_bin") != null && restore_res.get("recycle_bin").get(0).get("status") == "success")
{
	update_url = "https://www.zohoapis.com/crm/v2/Events/" + event_id;
	row = Map();
	row.put("Meeting_Status","Cancelled");
	// Prepare data list for update
	data_list = List();
	data_list.add(row);
	data = Map();
	data.put("data",data_list);
	// Important: prevent this update from re-triggering other workflows
	data.put("trigger",List());
	update_res = invokeurl
	[
		url :update_url
		type :PUT
		parameters:data.toString()
		connection:"zoho_crm"
	];
	info "Status Forced to Cancelled: " + update_res;
}
else
{
	info "Restore failed or record was not in bin yet.";
}
info "--- END RESTORE ---";
}
