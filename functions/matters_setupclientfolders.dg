string standalone.matters_setupClientFolders(String dealId)
{
// =========================================================
// CONFIG  (the only section you edit when templates change)
// =========================================================
WD_BASE = "https://www.zohoapis.com/workdrive/api/v1";
CRM_BASE = "https://www.zohoapis.com/crm/v2.1";
// Parent / root folders
ACCT_TEAMFOLDER = "nb34806f9a0df8e0e4d55a024f0130d977e10";
// estate/elder accounts root
PROBATE_PARENT = "doxb568c8f590be0b48f29138e7391cd8e1ef";
// Probate parent folder
// Share-link behavior
LINK_ROLE_ID = "7";
// 5 Editor, 6 View&Comment, 7 Upload, 34 Viewer
LINK_ALLOW_DL = true;
LINK_REQUEST_USER = true;
// if true, input_fields below are sent
LINK_USER_FIELDS = {"Name"};
// any of: Name, Phone, Email
LINK_USE_PASSWORD = true;
// if true, password_text is set on the link
LINK_EXPIRE_MONTHS = 0;
// 0 = no expiry; >0 sets expiration_date
// Attachment linking (folders -> CRM Attachments related list)
ATTACH_ACCT_FOLDER = true;
// attach account folder to the Account
ATTACH_DEAL_FOLDER = true;
// attach client/master folder to the Deal
// Probate template subfolder IDs
PROBATE_SRC = {"2qpvd1c8bb53ccb5e4ad5bc81f38d6c207878","2qpvd87d602d359a8427db85b4af57df135a2","o32dg877852d9054e4ca2ba95f431faa747cf","2qpvd26a17a580bbb490e9a8f965047382716","o32dgaa76dd540b944eb5a7780aa358be5bed","2qpvd43fff152ec3347388b66ee9d7a730cc3","2qpvd4045740029884f53b107f6ec20b5feea","o32dg65d6a51a2bee41f787e92920f59982a2"};
// Estate Planning / Elder Law template config, keyed by variant.
// bod       = files copied into the "1. BOD" folder
// loose     = files copied into the account folder root
// master    = folder ID copied in (Trust/Will) -> becomes share target
// children  = contents of "2. Master Client Folder" (Elder only)
// makeMaster= true -> create master folder & copy children (Elder)
//             false -> copy the master folder itself (Trust/Will)
VARIANT_CFG = Map();
trustCfg = Map();
trustCfg.put("bod",{"nb348fe575333d89b406fa34f422c7d8fda69","nb348e521db090ea54a6e84408890de56cc69","nb3482defb643ff0346039f1a5834c3dcd89b","nb348b5f18d072a1f42239364b985d7842814","nb348056942a0fd3846bab8d17325c93ff87c"});
trustCfg.put("master","nufrv530722214489494da4a1910b9098012d");
trustCfg.put("children",List());
trustCfg.put("loose",{"dhko6771d2684a796442f8bf1f841d8192a7f","mmp9150d56c46a6704f86b96e378cd05c3c96"});
trustCfg.put("makeMaster",false);
trustCfg.put("linkSuffix","_TrustPlan_ClientFolder");
VARIANT_CFG.put("Trust",trustCfg);
willCfg = Map();
willCfg.put("bod",{"nb3487f6b7934881f412d9456a35f2614eff9","nb348b9b513d3cfe641aa86ae285932c2f510","nb3487e673625527545a0990ceea8b3e22339","nb34813237b7b746c46b184fb8e1855163f6a","nb34864ef79cea71646d9a6697d76abcba55a"});
willCfg.put("master","nufrv2a61655726f64b3a978e1c498b5bc26a");
willCfg.put("children",List());
willCfg.put("loose",{"dhko6771d2684a796442f8bf1f841d8192a7f"});
willCfg.put("makeMaster",false);
willCfg.put("linkSuffix","_WillPlan_ClientFolder");
VARIANT_CFG.put("Will",willCfg);
elderCfg = Map();
elderCfg.put("bod",{"ofie42153d68c817c464ababf4031b32c1b85","ofie4fb2ea4f0c9e24cd2ba654f6573c92a4c","ofie4617c6299e79243a8bb450810ea8ac2f4","ofie474e946a0f5e547feb0b463989b322b42","ofie49ef5dc5263524f96af51f54dd18f2bbc"});
elderCfg.put("master","");
elderCfg.put("children",{"ofie40f9e2d139b414e258a33ea255dfab1ef","ofie4b9c79edd80a544539de0dbc1ce4d3b0b","ofie4a812d25afab74f57a428d26a5bf4eea6","ofie48e706ea11311423a9c5b4be054a11639","ofie4814bc5685f0e4e369b108ee720f185f7","ofie4461870c561034fe0b2cfc24a8849d5ae","81y7ubdf2626f996a42aeb6a766436e609e84"});
elderCfg.put("loose",{"dhko6771d2684a796442f8bf1f841d8192a7f","ofie457440cb803034d4cbd85b2f743c59ca1","ofie4cb3550a75c9e4191973a0ac19ddbfe15","jrqpu459a6d91af2e4f1e9570b725fab55bde"});
elderCfg.put("makeMaster",true);
elderCfg.put("linkSuffix","_EL_ClientFolder");
VARIANT_CFG.put("Elder",elderCfg);
// Shared headers
hdr = Map();
hdr.put("Accept","application/vnd.api+json");
// =========================================================
// READ DEAL + ACCOUNT
// =========================================================
deal = zoho.crm.getRecordById("Deals",dealId);
planType = ifnull(deal.get("Type"),"").toString();
pipeline = ifnull(deal.get("Pipeline"),"").toString();
acctLookup = deal.get("Account_Name");
if(acctLookup == null)
{
	info "Deal " + dealId + " has no Account - stopping.";
	return "".toString();
}
accountId = acctLookup.get("id");
acct = zoho.crm.getRecordById("Accounts",accountId);
acctName = ifnull(acct.get("Account_Name"),"").toString();
// Password generated once, used for both the link and the field.
pwd = zoho.encryption.md5(zoho.currenttime.toString()).subString(0,8);
try 
{
	// =================================================================
	// PROBATE  (pipeline) - separate workspace, no plan-type build
	// =================================================================
	if(pipeline.containsIgnoreCase("Probate"))
	{
		// Re-run guard (folder id already on the Account)
		if(ifnull(acct.get("zohoworkdriveforcrm__Workdrive_Folder_ID"),"").toString() != "")
		{
			info "Probate folder already built for Account " + accountId + " - skipping.";
			return "".toString();
		}
		cf = zoho.workdrive.createFolder(acctName,PROBATE_PARENT,"zworkdrive");
		probData = cf.get("data");
		probId = probData.get("id");
		// Copy the probate subfolder set
		items = List();
		for each  rid in PROBATE_SRC
		{
			attr = Map();
			attr.put("resource_id",rid);
			node = Map();
			node.put("attributes",attr);
			node.put("type","files");
			items.add(node);
		}
		body = Map();
		body.put("data",items);
		invokeurl
		[
			url :WD_BASE + "/files/" + probId + "/copy"
			type :POST
			parameters:body.toString()
			headers:hdr
			connection:"zworkdrive"
		]
		// Attach probate folder to the Account record
		if(ATTACH_ACCT_FOLDER)
		{
			standalone.attachFolderToRecord("Accounts",accountId,probData,CRM_BASE);
		}
		// NOTE: original wrote Probate to a different field namespace than
		// Estate Planning (zohoworkdriveforcrm__* vs zworkdrive_folderID).
		// Confirm this is intended - an Account that gets Probate THEN an
		// Estate Planning deal will build a fresh account folder because
		// the EP branch checks the other field.
		pUpd = Map();
		pUpd.put("zohoworkdriveforcrm__Workdrive_Folder_ID",probId);
		pUpd.put("zohoworkdriveforcrm__Workdrive_Folder_URL","https://workdrive.zoho.com/folder/" + probId);
		info zoho.crm.updateRecord("Accounts",accountId,pUpd);
		info "Probate build complete for Account " + accountId + ".";
		return "".toString();
	}
	// =================================================================
	// RESOLVE VARIANT  (everything below here = future "worker")
	// =================================================================
	variant = "";
	if(pipeline.containsIgnoreCase("Elder"))
	{
		variant = "Elder";
	}
	else if(planType.containsIgnoreCase("Trust"))
	{
		variant = "Trust";
	}
	else if(planType.containsIgnoreCase("Will"))
	{
		variant = "Will";
	}
	else
	{
		info "Deal " + dealId + " is not Elder Law / Trust / Will - stopping.";
		return "".toString();
	}
	// Re-run guard
	if(ifnull(deal.get("Folder_Link"),"").toString() != "" || ifnull(deal.get("Client_Folder_Share_Link"),"").toString() != "")
	{
		info "Folders already built for Deal " + dealId + " - skipping.";
		return "".toString();
	}
	cfg = VARIANT_CFG.get(variant);
	bodSrc = cfg.get("bod");
	looseSrc = cfg.get("loose");
	masterChildren = cfg.get("children");
	masterCopyId = cfg.get("master");
	makeMasterFolder = cfg.get("makeMaster");
	linkName = acctName + cfg.get("linkSuffix");
	// =================================================================
	// BUILD
	// =================================================================
	// Account folder (reuse if recorded, else create + attach)
	acctFolder = ifnull(acct.get("zworkdrive_folderID"),"").toString();
	if(acctFolder == "")
	{
		cf = zoho.workdrive.createFolder(acctName,ACCT_TEAMFOLDER,"zworkdrive");
		acctData = cf.get("data");
		acctFolder = acctData.get("id");
		info zoho.crm.updateRecord("Accounts",accountId,{"zworkdrive_folderID":acctFolder});
		if(ATTACH_ACCT_FOLDER)
		{
			standalone.attachFolderToRecord("Accounts",accountId,acctData,CRM_BASE);
		}
	}
	// BOD folder
	cf = zoho.workdrive.createFolder("1. BOD - " + acctName,acctFolder,"zworkdrive");
	bodId = cf.get("data").get("id");
	// Master folder: create-and-fill (Elder) OR copy-in (Trust/Will)
	jobs = List();
	// each job = { dest folder id, src id list }
	j = Map();
	j.put("dest",bodId);
	j.put("src",bodSrc);
	jobs.add(j);
	masterId = "";
	masterData = null;
	// captured for Deal attachment when copied in
	if(makeMasterFolder)
	{
		cf2 = zoho.workdrive.createFolder("2. Master Client Folder",acctFolder,"zworkdrive");
		masterData = cf2.get("data");
		masterId = masterData.get("id");
		j = Map();
		j.put("dest",masterId);
		j.put("src",masterChildren);
		jobs.add(j);
	}
	else
	{
		items = List();
		attr = Map();
		attr.put("resource_id",masterCopyId);
		node = Map();
		node.put("attributes",attr);
		node.put("type","files");
		items.add(node);
		body = Map();
		body.put("data",items);
		mResp = invokeurl
		[
			url :WD_BASE + "/files/" + acctFolder + "/copy"
			type :POST
			parameters:body.toString()
			headers:hdr
			connection:"zworkdrive"
		];
		masterData = mResp.get("data").get(0);
		masterId = masterData.get("id");
	}
	// Loose files into the account folder root
	j = Map();
	j.put("dest",acctFolder);
	j.put("src",looseSrc);
	jobs.add(j);
	// One copy loop for every job
	for each  job in jobs
	{
		srcList = job.get("src");
		if(srcList.size() > 0)
		{
			items = List();
			for each  rid in srcList
			{
				attr = Map();
				attr.put("resource_id",rid);
				node = Map();
				node.put("attributes",attr);
				node.put("type","files");
				items.add(node);
			}
			body = Map();
			body.put("data",items);
			invokeurl
			[
				url :WD_BASE + "/files/" + job.get("dest") + "/copy"
				type :POST
				parameters:body.toString()
				headers:hdr
				connection:"zworkdrive"
			]
		}
	}
	// =================================================================
	// SHARE LINK on the master folder  (password now actually applied)
	// =================================================================
	lAttr = Map();
	lAttr.put("resource_id",masterId);
	lAttr.put("link_name",linkName);
	lAttr.put("role_id",LINK_ROLE_ID);
	lAttr.put("allow_download",LINK_ALLOW_DL);
	lAttr.put("request_user_data",LINK_REQUEST_USER);
	if(LINK_USE_PASSWORD)
	{
		lAttr.put("password_text",pwd);
	}
	if(LINK_EXPIRE_MONTHS > 0)
	{
		lAttr.put("expiration_date",zoho.currentdate.addMonth(LINK_EXPIRE_MONTHS).toString("yyyy-MM-dd"));
	}
	// Build input_fields when user data is requested (was missing before)
	if(LINK_REQUEST_USER)
	{
		inputFields = List();
		if(LINK_USER_FIELDS.contains("Name"))
		{
			f = Map();
			f.put("field_name","Name");
			f.put("field_type","TEXT");
			f.put("is_name_field","true");
			inputFields.add(f);
		}
		if(LINK_USER_FIELDS.contains("Phone"))
		{
			f = Map();
			f.put("field_name","Phone");
			f.put("field_type","PHONE");
			inputFields.add(f);
		}
		if(LINK_USER_FIELDS.contains("Email"))
		{
			f = Map();
			f.put("field_name","Email");
			f.put("field_type","EMAIL_ID");
			inputFields.add(f);
		}
		lAttr.put("input_fields",inputFields);
	}
	lNode = Map();
	lNode.put("attributes",lAttr);
	lNode.put("type","links");
	lBody = Map();
	lBody.put("data",lNode);
	lResp = invokeurl
	[
		url :WD_BASE + "/links"
		type :POST
		parameters:lBody.toString()
		headers:hdr
		connection:"zworkdrive"
	];
	shareLink = lResp.get("data").get("attributes").get("link");
	// Attach the client/master folder to the Deal
	if(ATTACH_DEAL_FOLDER && masterData != null)
	{
		standalone.attachFolderToRecord("Deals",dealId,masterData,CRM_BASE);
	}
	// =================================================================
	// WRITE BACK TO THE DEAL
	// =================================================================
	dealUpd = Map();
	dealUpd.put("Deal_Name",acctName);
	// matches old "Update CT"; drop if unwanted
	dealUpd.put("Password",pwd);
	if(variant == "Elder")
	{
		dealUpd.put("zworkdrive_folderID",masterId);
		dealUpd.put("Client_Folder_Share_Link",shareLink);
	}
	else
	{
		dealUpd.put("Folder_Link",shareLink);
	}
	info zoho.crm.updateRecord("Deals",dealId,dealUpd);
	info "Build complete for Deal " + dealId + " (variant: " + variant + ").";
}
catch (e)
{
	// Surface the failure clearly. If you have an error field on the Deal,
	// uncomment the updateRecord below to record it for support.
	info "ERROR building folders for Deal " + dealId + ": " + e.toString();
	// zoho.crm.updateRecord("Deals", dealId, {"Folder_Build_Error": e.toString()});
}
return "".toString();
}
