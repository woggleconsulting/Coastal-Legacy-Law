void automation.meetings_convertLeadOnLLPS(Int meetingId)
{
info "################################################################";
info "--- STARTING LLPS CONVERSION FOR MEETING ID: " + meetingId + " ---";
info "################################################################";
meetingRecord = zoho.crm.getRecordById("Events",meetingId);
// validate meeting and leads
if(meetingRecord.get("What_Id") == null)
{
	info "ABORTING: No 'Related To' record found on this meeting.";
	return;
}
moduleType = meetingRecord.get("$se_module");
if(moduleType != "Leads")
{
	info "ABORTING: Meeting is related to " + moduleType + ", not Leads.";
	return;
}
leadId = meetingRecord.get("What_Id").get("id");
meetingOwner = meetingRecord.get("Owner");
hostId = ifnull(meetingOwner.get("id"),"");
leadRecord = zoho.crm.getRecordById("Leads",leadId);
// check if already converted
if(leadRecord.get("id") != null && leadRecord.get("Is_Converted") == true)
{
	convertedDealId = leadRecord.get("Converted_Deal");
	if(convertedDealId != null)
	{
		zoho.crm.updateRecord("Events",meetingId,{"What_Id":convertedDealId,"Se_module":"Deals"});
		info "SUCCESS: Meeting re-associated to existing Deal.";
	}
	return;
}
leadEmail = leadRecord.get("Email");
companyName = ifnull(leadRecord.get("Company"),"New LLPS Deal");
spouseId = ifnull(leadRecord.get("Spouse_Partner"),Map()).get("id");
inquirerId = ifnull(leadRecord.get("Inquirer_Lead"),Map()).get("id");
// Initialize contact ID variables
spouseContactId = null;
inquiryContactId = null;
primaryContactId = null;
// Account Strategy: find or create (Your Correct File)
accountIdToUse = null;
searchAccount = zoho.crm.searchRecords("Accounts","(Account_Name:equals:" + companyName + ")");
if(searchAccount.size() > 0)
{
	accountIdToUse = searchAccount.get(0).get("id");
	info "Existing Account Found: " + accountIdToUse;
}
else
{
	// create account manually
	accMap = {"Account_Name":companyName};
	createAcc = zoho.crm.createRecord("Accounts",accMap);
	if(createAcc.get("id") != null)
	{
		accountIdToUse = createAcc.get("id");
		info "Created New Account Manually: " + accountIdToUse;
	}
}
// process spouse
if(spouseId != null)
{
	info "--- PROCESSING SPOUSE ---";
	spouseRecord = zoho.crm.getRecordById("Leads",spouseId);
	if(spouseRecord.get("Is_Converted") != true)
	{
		convertMapSpouse = {"overwrite_lead_source":true,"notify_lead_owner":true};
		if(accountIdToUse != null)
		{
			convertMapSpouse.put("Accounts",accountIdToUse);
		}
		spouseConv = zoho.crm.convertLead(spouseId,convertMapSpouse);
		info "Spouse Conversion Result: " + spouseConv;
		if(spouseConv.get("Contacts") != null)
		{
			spouseContactId = spouseConv.get("Contacts");
			// Ensure spouse is linked to correct account
			if(accountIdToUse != null)
			{
				zoho.crm.updateRecord("Contacts",spouseContactId,{"Account_Name":accountIdToUse});
				info "Linked Spouse Contact to Account: " + accountIdToUse;
			}
		}
	}
	else
	{
		// Already converted - get existing contact ID
		spouseContactId = spouseRecord.get("Converted_Contact");
		info "Spouse already converted - Contact ID: " + spouseContactId;
	}
}
// process inquirer
if(inquirerId != null)
{
	info "--- PROCESSING INQUIRER ---";
	inqRecord = zoho.crm.getRecordById("Leads",inquirerId);
	if(inqRecord.get("Is_Converted") != true)
	{
		convertMapInq = {"overwrite_lead_source":true,"notify_lead_owner":true};
		if(accountIdToUse != null)
		{
			convertMapInq.put("Accounts",accountIdToUse);
		}
		inqConv = zoho.crm.convertLead(inquirerId,convertMapInq);
		info "Inquirer Conversion Result: " + inqConv;
		if(inqConv.get("Contacts") != null)
		{
			inquiryContactId = inqConv.get("Contacts");
			// Ensure inquirer is linked to correct account
			if(accountIdToUse != null)
			{
				zoho.crm.updateRecord("Contacts",inquiryContactId,{"Account_Name":accountIdToUse});
				info "Linked Inquirer Contact to Account: " + accountIdToUse;
			}
		}
	}
	else
	{
		// Already converted - get existing contact ID
		inquiryContactId = inqRecord.get("Converted_Contact");
		info "Inquirer already converted - Contact ID: " + inquiryContactId;
	}
}
// process primary lead
info "--- PROCESSING PRIMARY LEAD ---";
dealData = {"Deal_Name":companyName,"Stage":"New / Intake","Pipeline":"Intake","Attorney":hostId};
convertMap = {"overwrite_lead_source":true,"notify_lead_owner":true,"Deals":dealData};
if(accountIdToUse != null)
{
	convertMap.put("Accounts",accountIdToUse);
}
existingContactId = null;
searchPrimary = zoho.crm.searchRecords("Contacts","(Email:equals:" + leadEmail + ")");
if(searchPrimary.size() > 0)
{
	existingContactId = searchPrimary.get(0).get("id");
	convertMap.put("Contacts",existingContactId);
	convertMap.put("overwrite",true);
	info "Found existing Contact with matching email: " + existingContactId;
}
// try conversion
convResponse = zoho.crm.convertLead(leadId,convertMap);
info "Primary Conversion Response: " + convResponse;
if(convResponse == null)
{
	info "ERROR: Lead conversion returned null response";
	return;
}
finalDealId = convResponse.get("Deals");
primaryContactId = convResponse.get("Contacts");
if(finalDealId == null)
{
	info "Deal ID not in conversion response - attempting recovery...";
	// find deal id
	checkLeadAgain = zoho.crm.getRecordById("Leads",leadId);
	if(checkLeadAgain.get("id") != null)
	{
		finalDealId = checkLeadAgain.get("Converted_Deal");
		info "Found Deal ID from Lead record: " + finalDealId;
	}
	// find primary contact if still missing
	if(primaryContactId == null)
	{
		primaryContactId = existingContactId;
	}
	if(primaryContactId == null)
	{
		info "Attempting to find Primary Contact via Meeting Re-fetch...";
		refetchedMeeting = zoho.crm.getRecordById("Events",meetingId);
		seModule = refetchedMeeting.get("$se_module");
		whatId = refetchedMeeting.get("What_Id");
		if(whatId != null)
		{
			if(seModule == "Contacts")
			{
				primaryContactId = whatId.get("id");
			}
			else if(seModule == "Deals")
			{
				ghostDeal = zoho.crm.getRecordById("Deals",whatId.get("id"));
				if(ghostDeal.get("Contact_Name") != null)
				{
					primaryContactId = ghostDeal.get("Contact_Name").get("id");
				}
			}
			else if(seModule == "Accounts")
			{
				ghostAccountId = whatId.get("id");
				relatedContacts = zoho.crm.getRelatedRecords("Contacts","Accounts",ghostAccountId);
				if(relatedContacts.size() > 0)
				{
					primaryContactId = relatedContacts.get(0).get("id");
				}
			}
		}
	}
	// manual deal creation if still missing
	if(finalDealId == null)
	{
		info "Recovery: Creating Deal MANUALLY.";
		// Determine contact for deal
		if(primaryContactId == null)
		{
			if(inquiryContactId != null)
			{
				primaryContactId = inquiryContactId;
			}
			else if(spouseContactId != null)
			{
				primaryContactId = spouseContactId;
			}
		}
		if(primaryContactId != null)
		{
			dealData.put("Contact_Name",primaryContactId);
			if(accountIdToUse != null)
			{
				dealData.put("Account_Name",accountIdToUse);
			}
			createDeal = zoho.crm.createRecord("Deals",dealData);
			if(createDeal.get("id") != null)
			{
				finalDealId = createDeal.get("id");
				info "Manually created Deal: " + finalDealId;
			}
		}
	}
}
// Ensure primary contact is linked to correct account
if(primaryContactId != null && accountIdToUse != null)
{
	zoho.crm.updateRecord("Contacts",primaryContactId,{"Account_Name":accountIdToUse});
	info "Linked Primary Contact to Account: " + accountIdToUse;
}
// Build and populate Other_Contacts subform on primary contact
if(primaryContactId != null)
{
	info "--- BUILDING OTHER_CONTACTS SUBFORM ---";
	subformRows = List();
	if(spouseContactId != null && spouseContactId != primaryContactId)
	{
		subformRows.add({"Contact":spouseContactId,"Contact_Relationship":"Spouse","Role_in_Estate_Planning":"Client"});
		info "Added Spouse to subform: " + spouseContactId;
	}
	if(inquiryContactId != null && inquiryContactId != primaryContactId && inquiryContactId != spouseContactId)
	{
		subformRows.add({"Contact":inquiryContactId,"Contact_Relationship":"Inquirer","Role_in_Estate_Planning":"Inquirer"});
		info "Added Inquirer to subform: " + inquiryContactId;
	}
	if(subformRows.size() > 0)
	{
		zoho.crm.updateRecord("Contacts",primaryContactId,{"Other_Contacts":subformRows});
		info "Populated Other_Contacts subform with " + subformRows.size() + " entries";
	}
	else
	{
		info "No additional contacts to add to subform";
	}
}
// Update Deal with all contact references
if(finalDealId != null)
{
	info "--- UPDATING DEAL FIELDS ---";
	updateMap = {"Attorney":hostId};
	// Set Contact_Name (prioritize inquirer, then primary)
	if(inquiryContactId != null)
	{
		updateMap.put("Contact_Name",inquiryContactId);
	}
	else if(primaryContactId != null)
	{
		updateMap.put("Contact_Name",primaryContactId);
	}
	// Set Spouse_Name
	if(spouseContactId != null)
	{
		updateMap.put("Spouse_Name",spouseContactId);
	}
	zoho.crm.updateRecord("Deals",finalDealId,updateMap);
	info "Updated Deal with contact references: " + updateMap;
	// Update Account name
	finalDealRecord = zoho.crm.getRecordById("Deals",finalDealId);
	if(finalDealRecord.get("Account_Name") != null)
	{
		finalAccountId = finalDealRecord.get("Account_Name").get("id");
		zoho.crm.updateRecord("Accounts",finalAccountId,{"Account_Name":companyName});
		info "Updated Account name to: " + companyName;
	}
	// Move meeting to deal
	zoho.crm.updateRecord("Events",meetingId,{"What_Id":finalDealId,"Se_module":"Deals"});
	info "SUCCESS: Meeting re-associated to Deal: " + finalDealId;
}
else
{
	info "FAILED: No Deal ID available after all recovery attempts.";
}
// Clean up ghost accounts
info "--- CHECKING FOR GHOST ACCOUNTS ---";
allContactIds = List();
if(primaryContactId != null)
{
	allContactIds.add(primaryContactId);
}
if(spouseContactId != null)
{
	allContactIds.add(spouseContactId);
}
if(inquiryContactId != null)
{
	allContactIds.add(inquiryContactId);
}
ghostAccounts = List();
for each  cId in allContactIds
{
	cRec = zoho.crm.getRecordById("Contacts",cId);
	if(cRec.get("Account_Name") != null)
	{
		accId = cRec.get("Account_Name").get("id");
		if(accId != accountIdToUse && !ghostAccounts.contains(accId))
		{
			ghostAccounts.add(accId);
			info "Identified Ghost Account: " + accId;
		}
	}
}
// Delete all ghost accounts
if(ghostAccounts.size() > 0)
{
	info "Deleting " + ghostAccounts.size() + " ghost account(s)";
	for each  ghostId in ghostAccounts
	{
		delResp = zoho.crm.invokeConnector("crm.delete",{"module":"Accounts","ids":ghostId});
		info "Deleted Ghost Account " + ghostId + ": " + delResp;
	}
}
else
{
	info "No ghost accounts found";
}
info "################################################################";
info "--- END OF SCRIPT ---";
info "################################################################";
}
