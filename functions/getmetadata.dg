string standalone.getMetaData()
{
// =====================================================================
//  CRM METADATA EXTRACTOR — v2.2 (Comprehensive)
//  Pulls all available system metadata via Zoho CRM v8 REST API
//  and writes categorized JSON files to a WorkDrive folder.
//
//  SETUP:
//    1. Replace teamFolderId with your target WorkDrive folder ID
//    2. Ensure the "zoho_crm" connection has these scopes:
//         ZohoCRM.settings.ALL, ZohoCRM.users.READ,
//         ZohoCRM.org.READ, ZohoCRM.modules.READ
//    3. Ensure the "zworkdrive" connection is configured
//
//  NOT CAPTURED BY THIS FUNCTION (collected manually):
//    - Custom Functions (Deluge source) — use browser bookmarklet
//    - Client Scripts — use browser bookmarklet
//    Both use: javascript:(function(){...zoho-crm-functions...})();
//
//  OUTPUT: 4 category JSON files + 1 index, written to WorkDrive.
//  RUNTIME: Expect 2-5 minutes depending on template count.
// =====================================================================
baseUrl = "https://www.zohoapis.com/crm/v8";
teamFolderId = "bvmdg66cd9db8a7094c24a19a70d7c8847bd2";
timestamp = zoho.currentdate.toString("yyyyMMdd_HHmmss");
errors = list();
// =====================================================================
//  1. ORG INFO
// =====================================================================
info "--- 1. Fetching org info ---";
orgResp = invokeurl
[
	url :baseUrl + "/org"
	type :GET
	connection:"zoho_crm"
];
if(orgResp.get("org") == null && orgResp.get("code") != null)
{
	info "ERROR [org]: " + orgResp;
	errors.add("org: " + orgResp);
}
orgInfo = ifnull(orgResp,Map());
// =====================================================================
//  2. USERS, ROLES, PROFILES
// =====================================================================
info "--- 2. Fetching users, roles, profiles ---";
usersResp = invokeurl
[
	url :baseUrl + "/users?type=AllUsers"
	type :GET
	connection:"zoho_crm"
];
if(usersResp.get("users") == null && usersResp.get("code") != null)
{
	info "ERROR [users]: " + usersResp;
	errors.add("users: " + usersResp);
}
rolesResp = invokeurl
[
	url :baseUrl + "/settings/roles"
	type :GET
	connection:"zoho_crm"
];
if(rolesResp.get("roles") == null && rolesResp.get("code") != null)
{
	info "ERROR [roles]: " + rolesResp;
	errors.add("roles: " + rolesResp);
}
profilesResp = invokeurl
[
	url :baseUrl + "/settings/profiles"
	type :GET
	connection:"zoho_crm"
];
if(profilesResp.get("profiles") == null && profilesResp.get("code") != null)
{
	info "ERROR [profiles]: " + profilesResp;
	errors.add("profiles: " + profilesResp);
}
usersRolesProfiles = Map();
usersRolesProfiles.put("users",ifnull(usersResp.get("users"),list()));
usersRolesProfiles.put("roles",ifnull(rolesResp.get("roles"),list()));
usersRolesProfiles.put("profiles",ifnull(profilesResp.get("profiles"),list()));
// =====================================================================
//  3. MODULES LIST (used to drive per-module loops below)
// =====================================================================
info "--- 3. Fetching modules list ---";
modulesResp = invokeurl
[
	url :baseUrl + "/settings/modules"
	type :GET
	connection:"zoho_crm"
];
if(modulesResp.get("modules") == null && modulesResp.get("code") != null)
{
	info "ERROR [modules]: " + modulesResp;
	errors.add("modules: " + modulesResp);
}
allModules = ifnull(modulesResp.get("modules"),list());
// Core modules to deep-dive. Excludes Notes (no views/related lists)
// and Booking_Forms_Submissions (NO_PERMISSION via API).
coreModuleNames = {"Leads","Contacts","Accounts","Deals","Events","Tasks","Campaigns","Decision_Vault_Forms","Calls"};
deepDiveModules = list();
if(allModules.size() > 0)
{
	for each  mod in allModules
	{
		modName = mod.get("api_name");
		if(coreModuleNames.contains(modName) || mod.get("generated_type") == "custom")
		{
			// Skip known inaccessible modules
			if(modName != "Booking_Forms_Submissions")
			{
				deepDiveModules.add(modName);
			}
		}
	}
}
else
{
	deepDiveModules = {"Leads","Contacts","Accounts","Deals","Events","Tasks","Campaigns"};
	info "WARN: Modules call failed, using hardcoded fallback list";
}
info "Deep-dive modules: " + deepDiveModules;
// =====================================================================
//  4. ORG VARIABLES
// =====================================================================
info "--- 4. Fetching org variables ---";
variablesResp = invokeurl
[
	url :baseUrl + "/settings/variables"
	type :GET
	connection:"zoho_crm"
];
if(variablesResp.get("variables") == null && variablesResp.get("code") != null)
{
	info "ERROR [variables]: " + variablesResp;
	errors.add("variables: " + variablesResp);
}
// =====================================================================
//  5. PER-MODULE METADATA: Fields, Layouts, Custom Views, Related Lists,
//     Validation Rules, Blueprint (per layout), Tags
// =====================================================================
info "--- 5. Fetching per-module metadata ---";
moduleMetadata = Map();
for each  modName in deepDiveModules
{
	info "  Processing module: " + modName;
	modData = Map();
	// 5a. Fields
	fieldsResp = invokeurl
	[
		url :baseUrl + "/settings/fields?module=" + modName
		type :GET
		connection:"zoho_crm"
	];
	if(fieldsResp.get("fields") == null && fieldsResp.get("code") != null)
	{
		info "  ERROR [fields/" + modName + "]: " + fieldsResp;
		errors.add("fields/" + modName + ": " + fieldsResp);
	}
	modData.put("fields",ifnull(fieldsResp.get("fields"),list()));
	// 5b. Layouts
	layoutsResp = invokeurl
	[
		url :baseUrl + "/settings/layouts?module=" + modName
		type :GET
		connection:"zoho_crm"
	];
	if(layoutsResp.get("layouts") == null && layoutsResp.get("code") != null)
	{
		info "  ERROR [layouts/" + modName + "]: " + layoutsResp;
		errors.add("layouts/" + modName + ": " + layoutsResp);
	}
	modData.put("layouts",ifnull(layoutsResp.get("layouts"),list()));
	// 5c. Custom Views
	viewsResp = invokeurl
	[
		url :baseUrl + "/settings/custom_views?module=" + modName
		type :GET
		connection:"zoho_crm"
	];
	// 204 = no custom views for this module, not an error
	modData.put("custom_views",ifnull(viewsResp.get("custom_views"),list()));
	// 5d. Related Lists
	relatedResp = invokeurl
	[
		url :baseUrl + "/settings/related_lists?module=" + modName
		type :GET
		connection:"zoho_crm"
	];
	// 204 = no related lists, not an error
	modData.put("related_lists",ifnull(relatedResp.get("related_lists"),list()));
	// 5e. Validation Rules
	validationResp = invokeurl
	[
		url :baseUrl + "/settings/validation_rules?module=" + modName
		type :GET
		connection:"zoho_crm"
	];
	// 204 = no validation rules configured, not an error
	modData.put("validation_rules",ifnull(validationResp.get("validation_rules"),list()));
	// 5f. Blueprint (requires layout_id per layout)
	modLayouts = ifnull(layoutsResp.get("layouts"),list());
	blueprintData = list();
	for each  lay in modLayouts
	{
		layId = lay.get("id");
		blueprintResp = invokeurl
		[
			url :baseUrl + "/settings/blueprint?module=" + modName + "&layout_id=" + layId
			type :GET
			connection:"zoho_crm"
		];
		if(blueprintResp != null && blueprintResp.get("blueprint") != null)
		{
			bpEntry = Map();
			bpEntry.put("layout_id",layId);
			bpEntry.put("layout_name",lay.get("name"));
			bpEntry.put("blueprint",blueprintResp.get("blueprint"));
			blueprintData.add(bpEntry);
		}
		// 204/400 = no blueprint for this layout, skip silently
	}
	modData.put("blueprints",blueprintData);
	// 5g. Tags
	tagsResp = invokeurl
	[
		url :baseUrl + "/settings/tags?module=" + modName
		type :GET
		connection:"zoho_crm"
	];
	// 204/400 = no tags for this module, not an error
	modData.put("tags",ifnull(tagsResp.get("tags"),list()));
	moduleMetadata.put(modName,modData);
}
// =====================================================================
//  6. PIPELINES (all layouts that have pipelines, primarily Deals)
// =====================================================================
info "--- 6. Fetching pipelines ---";
pipelinesResult = list();
dealsMetadata = moduleMetadata.get("Deals");
if(dealsMetadata != null)
{
	dealsLayouts = dealsMetadata.get("layouts");
	if(dealsLayouts != null)
	{
		for each  layout in dealsLayouts
		{
			layoutId = layout.get("id");
			pipeResp = invokeurl
			[
				url :baseUrl + "/settings/pipeline?layout_id=" + layoutId
				type :GET
				connection:"zoho_crm"
			];
			if(pipeResp != null && pipeResp.get("pipeline") != null)
			{
				pipeData = Map();
				pipeData.put("layout_id",layoutId);
				pipeData.put("layout_name",layout.get("name"));
				pipeData.put("pipelines",pipeResp.get("pipeline"));
				pipelinesResult.add(pipeData);
			}
		}
	}
}
info "Pipelines found: " + pipelinesResult.size();
// =====================================================================
//  7. AUTOMATION — Workflow Rules (list + individual details)
// =====================================================================
info "--- 7. Fetching workflow rules ---";
workflowsResp = invokeurl
[
	url :baseUrl + "/settings/automation/workflow_rules"
	type :GET
	connection:"zoho_crm"
];
workflowList = ifnull(workflowsResp.get("workflow_rules"),list());
info "Workflow rules found: " + workflowList.size();
workflowsDetailed = list();
for each  wf in workflowList
{
	wfId = wf.get("id");
	wfDetailResp = invokeurl
	[
		url :baseUrl + "/settings/automation/workflow_rules/" + wfId
		type :GET
		connection:"zoho_crm"
	];
	if(wfDetailResp != null && wfDetailResp.get("workflow_rules") != null)
	{
		workflowsDetailed.add(wfDetailResp.get("workflow_rules").get(0));
	}
	else
	{
		info "  WARN [workflow detail/" + wfId + "]: falling back to summary";
		workflowsDetailed.add(wf);
	}
}
info "Workflow details fetched: " + workflowsDetailed.size();
// =====================================================================
//  8. AUTOMATION — Tasks, Field Updates, Webhooks, Email Notifications
// =====================================================================
info "--- 8. Fetching automation actions ---";
automationTasksResp = invokeurl
[
	url :baseUrl + "/settings/automation/tasks"
	type :GET
	connection:"zoho_crm"
];
if(automationTasksResp.get("tasks") == null && automationTasksResp.get("code") != null)
{
	info "ERROR [automation/tasks]: " + automationTasksResp;
	errors.add("automation/tasks: " + automationTasksResp);
}
fieldUpdatesResp = invokeurl
[
	url :baseUrl + "/settings/automation/field_updates"
	type :GET
	connection:"zoho_crm"
];
if(fieldUpdatesResp.get("field_updates") == null && fieldUpdatesResp.get("code") != null)
{
	info "ERROR [automation/field_updates]: " + fieldUpdatesResp;
	errors.add("automation/field_updates: " + fieldUpdatesResp);
}
webhooksResp = invokeurl
[
	url :baseUrl + "/settings/automation/webhooks"
	type :GET
	connection:"zoho_crm"
];
// 204 = no webhooks configured, not an error
emailNotificationsResp = invokeurl
[
	url :baseUrl + "/settings/automation/email_notifications"
	type :GET
	connection:"zoho_crm"
];
if(emailNotificationsResp.get("email_notifications") == null && emailNotificationsResp.get("code") != null)
{
	info "ERROR [automation/email_notifications]: " + emailNotificationsResp;
	errors.add("automation/email_notifications: " + emailNotificationsResp);
}
automationActions = Map();
automationActions.put("tasks",ifnull(automationTasksResp,Map()));
automationActions.put("field_updates",ifnull(fieldUpdatesResp,Map()));
automationActions.put("webhooks",ifnull(webhooksResp,Map()));
automationActions.put("email_notifications",ifnull(emailNotificationsResp,Map()));
// =====================================================================
//  9. SCORING RULES
//     Path: /settings/automation/scoring_rules
// =====================================================================
info "--- 9. Fetching scoring rules ---";
scoringResp = invokeurl
[
	url :baseUrl + "/settings/automation/scoring_rules"
	type :GET
	connection:"zoho_crm"
];
if(scoringResp.get("scoring_rules") == null && scoringResp.get("code") != null)
{
	info "ERROR [scoring_rules]: " + scoringResp;
	errors.add("scoring_rules: " + scoringResp);
}
// =====================================================================
//  10. ASSIGNMENT RULES (per module)
// =====================================================================
info "--- 10. Fetching assignment rules ---";
assignmentRules = Map();
assignModules = {"Leads","Contacts","Deals"};
for each  amod in assignModules
{
	assignResp = invokeurl
	[
		url :baseUrl + "/settings/automation/assignment_rules?module=" + amod
		type :GET
		connection:"zoho_crm"
	];
	if(assignResp != null && assignResp.get("assignment_rules") != null)
	{
		assignmentRules.put(amod,assignResp.get("assignment_rules"));
	}
	// 204 = no assignment rules for this module, skip silently
}
// =====================================================================
//  11. EMAIL TEMPLATES (list + full HTML content per template)
// =====================================================================
info "--- 11. Fetching email templates ---";
emailTemplatesList = list();
etFetchMore = true;
etPages = {1,2,3,4,5};
for each  etPage in etPages
{
	if(etFetchMore)
	{
		etResp = invokeurl
		[
			url :baseUrl + "/settings/email_templates?page=" + etPage + "&per_page=200"
			type :GET
			connection:"zoho_crm"
		];
		if(etResp != null && etResp.get("email_templates") != null)
		{
			pageTemplates = etResp.get("email_templates");
			emailTemplatesList.addAll(pageTemplates);
			etInfo = ifnull(etResp.get("info"),Map());
			etFetchMore = ifnull(etInfo.get("more_records"),false);
		}
		else
		{
			if(etPage == 1)
			{
				info "ERROR [email_templates list]: " + etResp;
				errors.add("email_templates list: " + etResp);
			}
			etFetchMore = false;
		}
	}
}
info "Found " + emailTemplatesList.size() + " email templates";
emailTemplatesDetailed = list();
for each  et in emailTemplatesList
{
	etId = et.get("id");
	etDetailResp = invokeurl
	[
		url :baseUrl + "/settings/email_templates/" + etId
		type :GET
		connection:"zoho_crm"
	];
	if(etDetailResp != null && etDetailResp.get("email_templates") != null)
	{
		emailTemplatesDetailed.add(etDetailResp.get("email_templates").get(0));
	}
	else
	{
		info "  WARN [email_template detail/" + etId + "]: falling back to summary";
		emailTemplatesDetailed.add(et);
	}
}
// =====================================================================
//  12. WIZARDS
// =====================================================================
info "--- 12. Fetching wizards ---";
wizardsResp = invokeurl
[
	url :baseUrl + "/settings/wizards"
	type :GET
	connection:"zoho_crm"
];
// 204 = no wizards configured, not an error
wizardsList = ifnull(wizardsResp.get("wizards"),list());
wizardsDetailed = list();
for each  wiz in wizardsList
{
	wizId = wiz.get("id");
	wizDetailResp = invokeurl
	[
		url :baseUrl + "/settings/wizards/" + wizId
		type :GET
		connection:"zoho_crm"
	];
	if(wizDetailResp != null && wizDetailResp.get("wizards") != null)
	{
		wizardsDetailed.add(wizDetailResp.get("wizards").get(0));
	}
	else
	{
		wizardsDetailed.add(wiz);
	}
}
// =====================================================================
//  13. WEBFORMS
// =====================================================================
info "--- 13. Fetching webforms ---";
webformsResp = invokeurl
[
	url :baseUrl + "/settings/webforms"
	type :GET
	connection:"zoho_crm"
];
// 204 = no webforms, not an error
// =====================================================================
//  14. PORTALS
// =====================================================================
info "--- 14. Fetching portals ---";
portalsResp = invokeurl
[
	url :baseUrl + "/settings/portals"
	type :GET
	connection:"zoho_crm"
];
// 204 = no portals, not an error
// =====================================================================
//  15. TERRITORIES
// =====================================================================
info "--- 15. Fetching territories ---";
territoriesResp = invokeurl
[
	url :baseUrl + "/settings/territories"
	type :GET
	connection:"zoho_crm"
];
// FEATURE_NOT_ENABLED is expected if territories aren't used
if(territoriesResp.get("territories") == null && territoriesResp.get("code") != null)
{
	info "INFO [territories]: " + territoriesResp.get("message");
}
// =====================================================================
//  16. CUSTOM BUTTONS (per deep-dive module)
// =====================================================================
info "--- 16. Fetching custom buttons ---";
customButtons = Map();
for each  btnMod in deepDiveModules
{
	btnResp = invokeurl
	[
		url :baseUrl + "/settings/custom_buttons?module=" + btnMod
		type :GET
		connection:"zoho_crm"
	];
	if(btnResp != null && btnResp.get("custom_buttons") != null)
	{
		customButtons.put(btnMod,btnResp.get("custom_buttons"));
	}
	// 204/403 = no buttons or module doesn't support them, skip silently
}
// =====================================================================
//  17. INVENTORY TEMPLATES
// =====================================================================
info "--- 18. Fetching inventory templates ---";
inventoryResp = invokeurl
[
	url :baseUrl + "/settings/inventory_templates"
	type :GET
	connection:"zoho_crm"
];
// 204 = no inventory templates, not an error
// =====================================================================
//  ERROR SUMMARY
// =====================================================================
info "--- ERROR SUMMARY ---";
if(errors.size() > 0)
{
	info "Total errors: " + errors.size();
	for each  err in errors
	{
		info "  >> " + err;
	}
}
else
{
	info "No errors detected.";
}
// =====================================================================
//  ASSEMBLE AND WRITE OUTPUT FILES
//  4 consolidated files + 1 index.
//  Custom functions + client scripts are collected manually via
//  browser bookmarklet and added to the project separately.
// =====================================================================
info "--- Writing output files ---";
fileIndex = Map();
// ----- FILE 1: SYSTEM + MODULES -----
file1 = Map();
file1.put("_meta",{"extracted":zoho.currentdate.toString("yyyy-MM-dd'T'HH:mm:ssZ"),"version":"v2.2","category":"system_and_modules","description":"Org info, users, roles, profiles, org variables, modules list, and per-module schemas (fields, layouts, custom views, related lists, validation rules, blueprints, tags, pipelines)","deep_dive_modules":deepDiveModules});
file1.put("org",orgInfo);
file1.put("users_roles_profiles",usersRolesProfiles);
file1.put("modules",allModules);
file1.put("variables",ifnull(variablesResp,Map()));
file1.put("module_metadata",moduleMetadata);
file1.put("pipelines",pipelinesResult);
f1Name = "crmMeta_systemAndModules_" + timestamp + ".json";
f1Upload = zoho.workdrive.uploadFile(file1.toString().toFile(f1Name),teamFolderId,f1Name,false,"zworkdrive");
info "Uploaded: " + f1Name;
fileIndex.put(f1Name,"Org, users, roles, profiles, variables, modules, fields, layouts, views, related lists, validation, blueprints, tags, pipelines");
// ----- FILE 2: AUTOMATION -----
file2 = Map();
file2.put("_meta",{"extracted":zoho.currentdate.toString("yyyy-MM-dd'T'HH:mm:ssZ"),"version":"v2.2","category":"automation","description":"Workflow rules (detailed with criteria/actions), automation tasks, field updates, webhooks, email notifications, assignment rules, scoring rules","counts":{"workflow_rules":workflowsDetailed.size()}});
file2.put("workflow_rules",workflowsDetailed);
file2.put("automation_tasks",ifnull(automationActions.get("tasks"),Map()));
file2.put("field_updates",ifnull(automationActions.get("field_updates"),Map()));
file2.put("webhooks",ifnull(automationActions.get("webhooks"),Map()));
file2.put("email_notifications",ifnull(automationActions.get("email_notifications"),Map()));
file2.put("assignment_rules",assignmentRules);
file2.put("scoring_rules",ifnull(scoringResp,Map()));
f2Name = "crmMeta_automation_" + timestamp + ".json";
f2Upload = zoho.workdrive.uploadFile(file2.toString().toFile(f2Name),teamFolderId,f2Name,false,"zworkdrive");
info "Uploaded: " + f2Name;
fileIndex.put(f2Name,"Workflow rules, tasks, field updates, webhooks, email notifications, assignment/scoring rules (" + workflowsDetailed.size() + " workflows)");
// ----- FILE 3: EMAIL TEMPLATES -----
file3 = Map();
file3.put("_meta",{"extracted":zoho.currentdate.toString("yyyy-MM-dd'T'HH:mm:ssZ"),"version":"v2.2","category":"email_templates","description":"All email templates with full HTML content, merge fields, subjects, folders, and send/open statistics","count":emailTemplatesDetailed.size()});
file3.put("email_templates",emailTemplatesDetailed);
f3Name = "crmMeta_emailTemplates_" + timestamp + ".json";
f3Upload = zoho.workdrive.uploadFile(file3.toString().toFile(f3Name),teamFolderId,f3Name,false,"zworkdrive");
info "Uploaded: " + f3Name;
fileIndex.put(f3Name,"Email templates with full HTML (" + emailTemplatesDetailed.size() + " templates)");
// ----- FILE 4: UI CONFIG -----
file4 = Map();
file4.put("_meta",{"extracted":zoho.currentdate.toString("yyyy-MM-dd'T'HH:mm:ssZ"),"version":"v2.2","category":"ui_config","description":"Wizards, webforms, custom buttons per module, portals, territories, inventory templates"});
file4.put("wizards",wizardsDetailed);
file4.put("webforms",ifnull(webformsResp,Map()));
file4.put("custom_buttons",customButtons);
file4.put("portals",ifnull(portalsResp,Map()));
file4.put("territories",ifnull(territoriesResp,Map()));
file4.put("inventory_templates",ifnull(inventoryResp,Map()));
f4Name = "crmMeta_uiConfig_" + timestamp + ".json";
f4Upload = zoho.workdrive.uploadFile(file4.toString().toFile(f4Name),teamFolderId,f4Name,false,"zworkdrive");
info "Uploaded: " + f4Name;
fileIndex.put(f4Name,"Wizards, webforms, custom buttons, portals, territories");
// ----- INDEX FILE -----
indexFile = Map();
indexFile.put("_meta",{"extracted":zoho.currentdate.toString("yyyy-MM-dd'T'HH:mm:ssZ"),"version":"v2.2","description":"Index of all exported metadata files. Add all 4 category files to a Claude project. Custom functions and client scripts are collected separately via browser bookmarklet."});
indexFile.put("files",fileIndex);
indexFile.put("stats",{"deep_dive_modules":deepDiveModules,"modules_deep_dived":deepDiveModules.size(),"workflow_rules":workflowsDetailed.size(),"email_templates":emailTemplatesDetailed.size(),"wizards":wizardsDetailed.size(),"total_category_files":4,"total_errors":errors.size()});
indexFile.put("errors",errors);
indexFile.put("manual_collection_needed",{"custom_functions":"Export via browser bookmarklet — no v8 API endpoint exists to list function source code","client_scripts":"Export via browser bookmarklet — requires scope not available via connections"});
idxName = "crmMeta_INDEX_" + timestamp + ".json";
idxUpload = zoho.workdrive.uploadFile(indexFile.toString().toFile(idxName),teamFolderId,idxName,false,"zworkdrive");
info "Uploaded index: " + idxName;
info "=== METADATA EXTRACTION COMPLETE ===";
info "4 category files + 1 index written to WorkDrive";
info "Total errors: " + errors.size();
return indexFile.toString();
}
