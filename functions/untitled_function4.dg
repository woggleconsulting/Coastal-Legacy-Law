void ConnectorAction.Untitled_Function4()
{
m = Map();
resp = zoho.crm.invokeConnector("crm.getorg",m);
orgDetails = resp.toMap().get("response").toMap().get("org");
zgid = orgDetails.toMap().get("zgid");
getmap = {"nameSpace":"<portal_name.extension_namespace>"};
plugin_version = "";
plugin_details_response = zoho.crm.invokeConnector("zohobookingstest.bookingsapi.getplugindetails",m);
plugin_list = plugin_details_response.get("data").toJSONList();
for each  plugin in plugin_list
{
	plugin = plugin.toMap();
	if(plugin.get("PLUGIN_NAME").contains("zohobookingstest"))
	{
		plugin_version = plugin.get("PLUGIN_VERSION");
	}
}
apiresponse = zoho.crm.invokeConnector("crm.zapikey",getmap);
zapikey = apiresponse.get("response");
crm_signal_webhook_url = "https://platform.zoho.com/crm/v2/functions/zohobookingstest__addeventandcontactfromzohobookings/actions/execute?auth_type=apikey&zapikey=" + zapikey;
scheduledMap = Map();
scheduledMap.put("reqBody",{"urlMap":{"ACTION":"ADD","WEBHOOK_URL":crm_signal_webhook_url,"ORG_ID":zgid,"CUSTOMER_MODULE":zoho.crm.getOrgVariable("zohobookingstest__Module"),"PLUGIN_VERSION":plugin_version}});
response = zoho.crm.invokeConnector("zohobookingstest.bookingsapi.crmpluginhandler",scheduledMap);
dynamic_map = Map();
dynamic_map.put("linkDetails",zoho.encryption.urlEncode({"ID":""}));
bookingUrl = zoho.crm.invokeConnector("zohobookingstest.bookingsapi.getbookinglink",dynamic_map);
urlresponse = bookingUrl.toMap().get("response").toMap().get("response").toMap().get("returnvalue");
bookingLink = urlresponse.get("bookingLink");
setresponse = zoho.crm.invokeConnector("crm.set",{"apiname":"zohobookingstest__BookingUrl","value":zoho.encryption.urlDecode(bookingLink)});
setresponse = zoho.crm.invokeConnector("crm.set",{"apiname":"zohobookingstest__BookingUrlId","value":urlresponse.get("module") + "_id=" + urlresponse.get("id")});
}
