string standalone.DVQuestionnaireIDGlobalSet()
{
getQuestionnaireIDsHeaders = Map();
getQuestionnaireIDsHeaders.put("Authorization","Token " + zoho.crm.getOrgVariable("CRMVariableOAuthToken"));
getQuestionnaireIDsHeaders.put("Accept","application/json");
getQuestionnaireIDsResponse = invokeurl
[
	url :"https://api.decisionvault.com/v1/questionnaires"
	type :GET
	headers:getQuestionnaireIDsHeaders
];
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// initialize a list for the response data to be parsed and added
questionnaireIDs = list();
getQuestionnaireIDsResults = getQuestionnaireIDsResponse.get("results");
info getQuestionnaireIDsResults;
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//// loop through the list that is returned from the API, place them into our list
for each  questionnaireID in getQuestionnaireIDsResults
{
	if(questionnaireID.get("active") == true)
	{
		questionnaireIDs.add(questionnaireID);
	}
}
info questionnaireIDs;
GetGlobalSets = invokeurl
[
	url :"https://www.zohoapis.com/crm/v8/settings/global_picklists"
	type :GET
	connection:"zoho_crm"
];
info GetGlobalSets;
AllGlobalSets = GetGlobalSets.get("global_picklists");
DVQuestionnaireIDsGlobalSetExists = false;
GlobalPicklists = list();
for each  GlobalSet in AllGlobalSets
{
	GlobalSetName = GlobalSet.get("display_label");
	if(GlobalSetName == "DV Questionnaire IDs")
	{
		DVQuestionnaireIDsGlobalSetExists = true;
	}
}
info DVQuestionnaireIDsGlobalSetExists;
if(!DVQuestionnaireIDsGlobalSetExists)
{
	NewDVQuestionnaireIDsGlobalSet = Map();
	NewDVQuestionnaireIDsGlobalSet.put("display_label","DV Questionnaire IDs");
	NewDVQuestionnaireIDsGlobalSet.put("description","Questionnaires from Decision Vault");
	NewDVQuestionnaireIDsGlobalSet.put("pick_list_values_sorted_lexically",false);
	GlobalPicklists.add(NewDVQuestionnaireIDsGlobalSet);
	PickListValues = list();
	for each  QuestionnaireID in questionnaireIDs
	{
		NewValue = Map();
		NewValue.put("display_value",QuestionnaireID.get("url_short_name"));
		NewValue.put("type","used");
		PickListValues.add(NewValue);
	}
	NewDVQuestionnaireIDsGlobalSet.put("pick_list_values",PickListValues);
	CreateNewGlobalSetMap = Map();
	CreateNewGlobalSetMap.put("global_picklists",GlobalPicklists);
	CreateNewGlobalSet = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v8/settings/global_picklists"
		type :POST
		parameters:CreateNewGlobalSetMap.toString()
		connection:"zoho_crm"
	];
	info CreateNewGlobalSet;
}
else
{
	DVGlobalSetID = "";
	for each  GlobalSet in AllGlobalSets
	{
		if(GlobalSet.get("display_label") == "DV Questionnaire IDs")
		{
			DVGlobalSetID = GlobalSet.get("id");
			break;
		}
	}
	if(DVGlobalSetID != "")
	{
		GlobalSetDetailResponse = invokeurl
		[
			url :"https://www.zohoapis.com/crm/v8/settings/global_picklists/" + DVGlobalSetID
			type :GET
			connection:"zoho_crm"
		];
		info GlobalSetDetailResponse;
		ExistingPicklistValues = GlobalSetDetailResponse.get("global_picklists").get(0).get("pick_list_values");
		info ExistingPicklistValues;
	}
	info questionnaireIDs;
	// Build easy-to-compare sets
	questionnaireMap = Map();
	for each  q in questionnaireIDs
	{
		shortName = q.get("url_short_name");
		questionnaireMap.put(shortName,true);
	}
	existingMap = Map();
	for each  val in ExistingPicklistValues
	{
		existingMap.put(val.get("display_value"),true);
	}
	// Lists to build
	KeepList = list();
	NewValues = list();
	DeleteList = list();
	// Find keep values (in both new and existing)
	for each  q in questionnaireIDs
	{
		shortName = q.get("url_short_name");
		if(existingMap.containsKey(shortName))
		{
			keepVal = Map();
			keepVal.put("display_value",shortName);
			keepVal.put("type","used");
			for each  val in ExistingPicklistValues
			{
				if(val.get("display_value") == shortName)
				{
					keepVal.put("id",val.get("id"));
					break;
				}
			}
			KeepList.add(keepVal);
		}
	}
	// Find new values (in new but not in existing)
	for each  q in questionnaireIDs
	{
		shortName = q.get("url_short_name");
		if(!existingMap.containsKey(shortName))
		{
			newVal = Map();
			newVal.put("display_value",shortName);
			newVal.put("type","used");
			NewValues.add(newVal);
		}
	}
	// Find deleted values (in existing but not in new)
	for each  val in ExistingPicklistValues
	{
		displayValue = val.get("display_value");
		if(displayValue != "-None-" && !questionnaireMap.containsKey(displayValue))
		{
			deleteVal = Map();
			deleteVal.put("display_value",displayValue);
			deleteVal.put("type","unused");
			deleteVal.put("id",val.get("id"));
			DeleteList.add(deleteVal);
		}
	}
	// Combine all together
	FinalPicklistValues = list();
	FinalPicklistValues.addAll(KeepList);
	FinalPicklistValues.addAll(NewValues);
	FinalPicklistValues.addAll(DeleteList);
	info "Keep: " + KeepList;
	info "New: " + NewValues;
	info "Delete: " + DeleteList;
	info "FinalPicklistValues: " + FinalPicklistValues;
	UpdateGlobalSetMap = Map();
	UpdateGlobalSetMap.put("display_label","DV Questionnaire IDs");
	UpdateGlobalSetMap.put("description","Questionnaires from Decision Vault");
	UpdateGlobalSetMap.put("pick_list_values_sorted_lexically",false);
	UpdateGlobalSetMap.put("pick_list_values",FinalPicklistValues);
	FinalMap = Map();
	GlobalPicklistsList = list();
	GlobalPicklistsList.add(UpdateGlobalSetMap);
	FinalMap.put("global_picklists",GlobalPicklistsList);
	info FinalMap;
	UpdateResponse = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v8/settings/global_picklists/" + DVGlobalSetID
		type :PATCH
		parameters:FinalMap.toString()
		connection:"zoho_crm"
	];
	info UpdateResponse;
}
return "";
}
