void automation.meetings_updateMatterFields(Int meetingId)
{
// get meeting record
// based on Title field that contain the following update that specific Date field in the matter
// Legal Life Planning Session - LLPS Meeting Date
// Estate Plan Design Meeting → Design Meeting Date
// CIMI → CIMI-Review Date
// Signing → Signing Meeting Date
// Funding → FS1 Date (if its empty in the matter)
// Funding → Next FS Date
// should clear the date fields in the matter record if a meeting is rescheduled or canceled
info "Starting meetings_updateMatterFields for Meeting ID: " + meetingId;
meetingRecord = zoho.crm.getRecordById("Events",meetingId);
if(meetingRecord.get("id") == null)
{
	info "Error: Meeting record not found.";
	return;
}
whatId = meetingRecord.get("What_Id");
seModule = meetingRecord.get("$se_module");
if(whatId == null || seModule != "Deals")
{
	info "Meeting is not related to a Matter (Deal). Skipping.";
	return;
}
matterId = whatId.get("id");
meetingTitle = ifnull(meetingRecord.get("Event_Title"),"");
meetingStatus = ifnull(meetingRecord.get("Meeting_Status"),"");
startDateTime = meetingRecord.get("Start_DateTime");
info "Title: " + meetingTitle + " | Status: " + meetingStatus;
updateMatterMap = Map();
shouldUpdateDV = false;
valueToSet = startDateTime;
if(meetingStatus == "Cancelled" || meetingStatus == "Canceled")
{
	info "Meeting is Cancelled. Clearing date.";
	valueToSet = null;
}
if(meetingTitle.containsIgnoreCase("Legal Life Planning Session") || meetingTitle.containsIgnoreCase("LLPS"))
{
	updateMatterMap.put("LLPS_Meeting",valueToSet);
	shouldUpdateDV = true;
}
else if(meetingTitle.containsIgnoreCase("Design Meeting"))
{
	updateMatterMap.put("Design_Meeting_Date",valueToSet);
}
else if(meetingTitle.containsIgnoreCase("CIMI"))
{
	updateMatterMap.put("CIMI_Review_Date_Time",valueToSet);
}
else if(meetingTitle.containsIgnoreCase("Signing"))
{
	updateMatterMap.put("Signing_Meeting",valueToSet);
}
else if(meetingTitle.containsIgnoreCase("Funding"))
{
	updateMatterMap.put("Funding_Meeting",valueToSet);
}
else if(meetingTitle.containsIgnoreCase("Document Review"))
{
	updateMatterMap.put("Doc_Review",valueToSet);
}
if(updateMatterMap.size() > 0)
{
	info "Updating Matter [" + matterId + "] fields: " + updateMatterMap;
	resp = zoho.crm.updateRecord("Deals",matterId,updateMatterMap);
	info "Matter Update Response: " + resp;
}
if(shouldUpdateDV)
{
	info "Attempting to update Decision_Vault_Forms Due_Date...";
	dvRecords = zoho.crm.getRelatedRecords("Decision_Vault_Forms","Deals",matterId);
	if(dvRecords.size() > 0)
	{
		dateOnlyVal = null;
		if(valueToSet != null)
		{
			dateOnlyVal = valueToSet.toDate();
		}
		for each  dvRecord in dvRecords
		{
			dvId = dvRecord.get("id");
			dvUpdateMap = Map();
			dvUpdateMap.put("Due_Date",dateOnlyVal);
			info "Updating DV Form [" + dvId + "] Due_Date to: " + dateOnlyVal;
			dvResp = zoho.crm.updateRecord("Decision_Vault_Forms",dvId,dvUpdateMap);
			info "DV Update Response: " + dvResp;
		}
	}
	else
	{
		info "No related Decision_Vault_Forms found for this Matter.";
	}
}
}
